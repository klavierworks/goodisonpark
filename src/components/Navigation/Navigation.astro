---
import { Image } from "astro:assets";
import { getFilters } from "../../api/utils";
import Filter from "../../components/Filter/Filter.astro";
import SimpleStadium from "../SimpleStadium/SimpleStadium.tsx";

type Props = {
  section: "grid" | "space";
}

const {section} = Astro.props;

const filters = getFilters();

const url = Astro.url;
const isSpaceView = url.pathname.includes('space');
---
<div class="filters" transition:name="filters" transition:persist>
  {filters.map(filter => <Filter class="filter" filter={filter} />)}
  <div class={`view-toggle ${isSpaceView ? 'isSpaceView' : 'isCanvasView'}`}>
    <div class="map">
      {isSpaceView ? (
        <SimpleStadium isShowingPoints={true} client:only />
      ) : (
        <a href="/space">
          <SimpleStadium client:only />
        </a>
      )}
    </div>
    <a class={`view grid ${section == 'grid' ? 'isActive' : ''}`}  href="/">Grid</a>
    <a class={`view space ${section == 'space' ? 'isActive' : ''}`} href="/space">Space</a>
  </div>
</div>
<script>
import { navigate } from "astro:transitions/client";
import { $activeFilters, $focusedEntry } from "../../store/data";

const mapElement = document.querySelector('.map');
$activeFilters.subscribe((filters) => {
  if (!mapElement) {
    return;
  }
  const currentFilterCount = Object.values(filters).length;
   if (currentFilterCount > 0) {
    mapElement.classList.add('hasActiveFilters');
  } else {
    mapElement.classList.remove('hasActiveFilters');
  }
});


document.querySelectorAll('a.view').forEach(link => {
  link.addEventListener('click', (e) => {
    e.preventDefault();
    const href = link.getAttribute('href');
    if (!href) {
      return;
    }
    const currentUrl = new URL(window.location.href);
    const newUrl = new URL(href, currentUrl.origin);
    newUrl.search = currentUrl.search;
    navigate(newUrl.toString());
  });
});

document.addEventListener("astro:after-swap", (event) => {
  const isSpaceView = window.location.pathname.includes('space');
  const viewElement = document.querySelector('.view-toggle');
  if (!viewElement) {
    return;
  }
  if (isSpaceView) {
    viewElement.classList.add('isSpaceView');
    viewElement.classList.remove('isCanvasView');
  } else {
    viewElement.classList.add('isCanvasView');
    viewElement.classList.remove('isSpaceView');
  }
  const gridElement = document.querySelector('.grid');
  const spaceElement = document.querySelector('.space');

  if (!gridElement || !spaceElement) {
    return;
  }
  if (isSpaceView) {
    gridElement.classList.remove('isActive');
    spaceElement.classList.add('isActive');
  } else {
    gridElement.classList.add('isActive');
    spaceElement.classList.remove('isActive');
  }
});

</script>
<style>
.filters {
  @mixin grid;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  pointer-events: none;

  @media (max-width: 600px) {
    display: flex;
    flex-direction: row-reverse;
    justify-content: start;
  }
}

.filter {
  grid-column: span 1;
  grid-row: 2 / 3;

  &:nth-child(1),
  &:nth-child(2) {
    order: 1;
  }

  &:nth-child(4),
  &:nth-child(5) {
    order: 3;
  }
}

.view-toggle {
  display: grid;
  grid-template-columns: repeat(2, 48px);
  grid-template-rows: max-content max-content;
  order: 2;
  place-self: center;
  position: relative;
  overflow: hidden;
  grid-row: 1 / 3;
  margin: 0 0 1.5em;
  
  @media (max-width: 600px) {
    grid-column: 1 / 2;
  }

  .view {
    @mixin button;
    grid-row: 2 / 3;
    display: flex;
    place-content: center;
    place-items: center;
    border: 1px solid white;
    padding: 5px 6px;
    text-decoration: none;
    pointer-events: auto;
    color: white;
    background-color: var(--navy);

    &:nth-child(3) {
      grid-column: 2 / 3 ;
    }
    
    &:nth-child(4){
      grid-column: 3 / 4;
    }
  }
  
  .isActive {
    color: var(--navy);
    background-color: white;
  }

}

.map {
  position: relative;
  grid-row: 1 / 2;
  grid-column: 1 / 3;
  aspect-ratio: 1 / 1;
  border: 1px solid white;
  background-color: var(--navy);
  z-index: -1;

  @media (max-width: 600px) {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 25%;
    translate: 0 0 !important;
  }
  
  a {
    pointer-events: all;
    cursor: pointer;
  }

  .isCanvasView & {
    @media (max-width: 600px) {
      display: none;
    }
  }

  .isSpaceView & {
    pointer-events: none !important;
    translate: 0 100%;
    transition: translate 0.3s ease-in-out;

    :global(div) {
      pointer-events: none !important;
    }
  }

  &.hasActiveFilters {
    translate: 0 0 !important;
  }
}
</style>

<style is:global>
  .map div {
    touch-action: none;
  }
  .isCanvasView canvas {
    pointer-events: none;
  }
</style>