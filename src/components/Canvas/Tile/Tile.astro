---
import VideoTile from './VideoTile/VideoTile.astro';

const { class: className, entry, isRear, ...rest } = Astro.props;
type Props = {
  class?: string;
  entry: Entry & {
    count: number;
  };
  isRear: boolean;
}

---
<tile-element data-id={entry.id} class={`${className} ${isRear ? 'isRear' : ''} isVisible`} isRear={isRear} {...rest}>
  <a href={`/space?memory=${entry.memory}`} data-astro-prefetch="tap">
    <VideoTile filename={entry.filename} name={entry.name} />
  </a>
</tile-element>
<script>
import { $allEntries, $entries } from "../../../store/data";
import { $hoveredEntry } from "../../../store/ui";

export class TileElement extends HTMLElement {
  entry = null as unknown as Entry;
  entriesListener: (() => void) | null = null;

  connectedCallback() {
    const id = this.getAttribute('data-id') as string;
    const isRear = this.hasAttribute('isRear') && this.getAttribute('isRear') === 'true';

    const entry = $allEntries.get().find(entry => entry.id === id);
    if (!entry) {
      console.error(`TileElement: No entry found for id ${id}`);
      return;
    }
    this.entry = entry;

    if (isRear) {
      return;
    }
    this.entriesListener = $entries.subscribe(entries => {
      const isVisible = !!entries.find(entry => entry.id === id);
      if (isVisible) {
        this.classList.add('isVisible');
      } else {
        this.classList.remove('isVisible');
      }
    });

    const isHoverableDevice = window.matchMedia(
      '(hover: hover) and (pointer: fine)'
    )
    
    if (!isHoverableDevice.matches) {
      return;
    }

    const hoverTarget = this.querySelector('a') as HTMLAnchorElement;
    if (!hoverTarget) {
      console.error('TileElement: No anchor element found');
      return;
    }
    hoverTarget.addEventListener('mouseover', () => {
      $hoveredEntry.set(this.entry);
    });

    hoverTarget.addEventListener('mouseleave', () => {
      $hoveredEntry.set(null);
    });
  }

  disconnectedCallback() {
    if (this.entriesListener) {
      this.entriesListener();
    }
  }
}

if (!customElements.get('tile-element')) {
  customElements.define('tile-element', TileElement);
}
</script>

<style is:global>
tile-element {
  height: 0;
  padding: 0;
  display: inline-flex;
  flex-direction: column;
  align-items: start;
  justify-content: center;
  opacity: 1;
  transition: all 0.25s ease-in-out;
  overflow: hidden;
  transform-origin: center center;

  a {
    display: contents;
    color: inherit;
    transform-style: preserve-3d;
    text-decoration: none;
  }

  &.isVisible {
    height: 100%;
    padding: 4vw;
  }

  h2 {
    @mixin button;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1em;
    margin: 0;
    max-width: 100%;
    white-space: nowrap;
  }

  .count {
    display: block;
    background-color: rgba(255 255 255 / 0.05);
    padding: 0.25em;
    line-height: 1;
  }

  .memory {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}

.column {
  --column-modifier: 1;
  transform-style: preserve-3d;
  pointer-events: none;
  
  tile-element {
    pointer-events: auto;
      transform: translateZ(calc(var(--column-modifier) * var(--row-modifier) * 1px));

      &:nth-child(odd) {
        --row-modifier: 2;
      }
      &:nth-child(even) {
        --row-modifier: 1;
      }
      &:nth-child(5n) {
        --row-modifier: 3;
      }
      &:nth-child(3n) {
        --row-modifier: -1;
      }
    }

  &:nth-child(odd) {
    --column-modifier: -1;
  }
}
</style>