---
import { getDatabase } from "../../../api/api";
import Tile from "../Tile/Tile.astro";
import { createColumns, type EntryWithCount, getEntriesWithCount } from './utils';

type Props = {
  isRear?: boolean;
}

const { isRear = false } = Astro.props as Props;

const entries = await getDatabase();

const entriesWithCount = getEntriesWithCount(entries);

// Shuffle the entries
const columns = createColumns(entriesWithCount) as unknown as EntryWithCount[][];
---
<masonry-element>
  {columns.map((column, index) => (
    <div class="column" data-column-id={index}>
      {column.map(entry => <Tile entry={entry} isRear={isRear} />)}
    </div>
  ))}
</masonry-element>

<script>

class MasonryElement extends HTMLElement {
  connectedCallback() {}
}

if (!customElements.get('masonry-element')) {
  customElements.define('masonry-element', MasonryElement);
}
</script>

<style is:global>
  masonry-element {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    pointer-events: none;
    .column {
      display: flex;
      flex-direction: column;
      width: 25vw;
      gap: 1rem;
    }

    .column:not(:has(.isVisible)) {
      width: 0;
    }
  }
</style>