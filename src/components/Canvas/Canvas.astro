---
import { getDatabase } from "../../api/api"
import Tile from "./Tile/Tile.astro";

const entries = await getDatabase();
const columns = entries.length > 0 ? Math.ceil(Math.sqrt(entries.length)) : 1;
const rows = Math.ceil(entries.length / columns);

let memoryCounts = new Map<string, number>();
entries.forEach(entry => {
  const memory = entry.memory;
  if (memoryCounts.has(memory)) {
    memoryCounts.set(memory, memoryCounts.get(memory)! + 1);
  } else {
    memoryCounts.set(memory, 1);
  }
});

const entriesWithCount = entries.map(entry => {
  const memory = entry.memory;
  const count = memoryCounts.get(memory);
  return {
    ...entry,
    count: count ?? 0,
  };
});
---
<canvas-element style={{
  '--columns': columns,
  '--rows': rows,
}}>
  {entriesWithCount.map(entry => (
    <div class="tile">
      <Tile entry={entry} />
    </div>
  ))}
</canvas-element>

<script>
import { $entries } from "../../store/data";

class CanvasElement extends HTMLElement {
  connectedCallback() {
    $entries.subscribe(entries => {
      const columns = entries.length > 0 ? Math.ceil(Math.sqrt(entries.length)) : 1;
      const rows = Math.ceil(entries.length / columns);

      this.style.setProperty('--columns', `${columns}`);
      this.style.setProperty('--rows', `${rows}`);
      console.log('CanvasElement connectedCallback', entries);
    })
  }
}
if (!customElements.get('canvas-element')) {
  customElements.define('canvas-element', CanvasElement);
}
</script>

<style>
canvas-element {
  --rows: 0;
  --columns: 0;
  --tile-width: 33vw;
  --tile-height: 33vw;
  display: grid;
  grid-template-columns: repeat(var(--columns), 1fr);
  grid-template-rows: repeat(var(--rows), 1fr);
  width: 100%;
  height: 100%;
  overflow: auto;
  scrollbar-width: none;

  .tile {
    width: calc(var(--tile-width) - 2vw);
    height: calc(var(--tile-height) - 2vw);
    padding: 2vw;
  }
}
</style>