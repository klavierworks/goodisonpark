---
import { getOptionsByFilter } from "../../api/api";
import { getFilterLabel } from "../../api/utils";

type Props = {
  class: string;
  filter: Filter;
}

const { class: className, filter, ...rest } = Astro.props as Props;

const unsortedOptions = await getOptionsByFilter(filter)
const options = unsortedOptions.sort((a, b) => {
  const aName = a.toLowerCase();
  const bName = b.toLowerCase();
  if (aName < bName) {
    return -1;
  }
  if (aName > bName) {
    return 1;
  }
  return 0;
});
---
<filter-element data-filter={filter} class={className} {...rest}>
  <input type="checkbox" id={`filter-${filter}`} />
  <ul class="options">
    {options.map((option) => (
      <li data-option={option}>{option}</li>
    ))}
  </ul>
  <label for={`filter-${filter}`} class="filter-name">
    <span class="cross-container">
      <span>{getFilterLabel(filter)}</span>
    </span>
  </label>
</filter-element>
<script>
import { getFilterLabel } from "../../api/utils";
import { $activeFilters, $entries } from "../../store/data";
import { $hasOpenFilters, $hoveredEntry } from "../../store/ui";

class FilterElement extends HTMLElement {
  isOpen = false;
  filter: Filter = this.getAttribute('data-filter')?.trim() as Filter;
  checkboxElement: HTMLInputElement = this.querySelector('input[type="checkbox"]')!

  connectedCallback() {
    this.querySelectorAll('li').forEach((option) => {
      option.addEventListener('click', this.handleClickOption.bind(this));
    });

    $entries.subscribe((entries) => {
      const options = entries.map((entry) => entry[this.filter]).filter(Boolean);
      const uniqueOptions = Array.from(new Set(options));
      this.querySelectorAll('li').forEach((option) => {
        const optionElement = option as HTMLLIElement;
        const optionName = optionElement.getAttribute('data-option');
        if (uniqueOptions.includes(optionName!)) {
          optionElement.classList.remove('isHidden');
        } else {
          optionElement.classList.add('isHidden');
        }
      });
    });

    const filterNameElement = this.querySelector('.cross-container')! as HTMLSpanElement;

    let previousHtml: string | undefined = undefined;
    $activeFilters.subscribe((activeFilters) => {
      const currentFilter = activeFilters[this.filter];
      this.querySelectorAll('li').forEach((option) => {
        const optionElement = option as HTMLLIElement;
        const isActive = currentFilter === optionElement.innerText;
        optionElement.classList.toggle('isActive', isActive);
      });
      if (currentFilter) {
        filterNameElement.innerHTML = `<span>${currentFilter}</span>`;
        previousHtml = filterNameElement.innerHTML;
        this.classList.add('hasActiveOption');
      } else {
        filterNameElement.innerText = getFilterLabel(this.filter);
        this.classList.remove('hasActiveOption');
      }
    });

    $hoveredEntry.subscribe((hoveredEntry) => {
      if (hoveredEntry && hoveredEntry[this.filter]) {
        previousHtml = filterNameElement.innerHTML;
        filterNameElement.innerHTML = `<span>${hoveredEntry[this.filter]}</span>`;
      } else if (previousHtml) {
        filterNameElement.innerHTML = previousHtml;
        previousHtml = undefined
      }
    });

    this.addEventListener('click', (event) => {
      if (!this.classList.contains('hasActiveOption')) {
        return;
      }
      event.stopPropagation();
      event.preventDefault();
      this.clearFilter();
    });

    this.checkboxElement.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      const isOpen = !!target.checked;
      
      if (isOpen) {
        this.handleOpen();
      } else {
        this.handleClose();
      }
    });
  }

  handleOpen() {
    this.isOpen = true;
    this.checkboxElement.checked = true;
    $hasOpenFilters.set(true);

    window.addEventListener('click', this.handleClickOutside)
  }
  handleClose() {
    this.isOpen = false;
    this.checkboxElement.checked = false;
    $hasOpenFilters.set(false);

    window.removeEventListener('click', this.handleClickOutside)
  }

  handleClickOutside = (event: MouseEvent) => {
    const target = event.target as HTMLElement;
    const isClickInside = this.contains(target);
    if (!isClickInside) {
      this.handleClose();
    }
  }

  clearFilter() {
    const newFilters = { ...$activeFilters.get() };
    delete newFilters[this.filter];

    document.dispatchEvent(new CustomEvent('filtering', {
      detail: {
        filters: newFilters,
      },
    }));
  }

  handleClickOption(event: MouseEvent) {
    this.handleClose();
    const target = event.target as HTMLLIElement;
    const isFilterBeingDeactivated = $activeFilters.get()[this.filter] === target.innerText;

    if (isFilterBeingDeactivated) {
      this.clearFilter();
      return;
    }

    const newFilters = {
      ...$activeFilters.get(),
      [this.filter]: target.innerText,
    };

    document.dispatchEvent(new CustomEvent('filtering', {
      detail: {
        filters: newFilters,
      },
    }));

    event.preventDefault();
    event.stopPropagation();
  }
}

if (!customElements.get('filter-element')) {
  customElements.define('filter-element', FilterElement);
}
</script>
<style>
input[type="checkbox"] {
  display: none;
}
filter-element {
  @mixin body;
  width: 100%;
  text-align: center;
  position: relative;
  pointer-events: auto;
}

.options {
  position: absolute;
  bottom: 100%;
  left: 0;
  right: 0;
  max-height: 0;
  transition: max-height 0.5s ease-in-out;
  overflow: hidden;
  scrollbar-width: none;
  margin: 0;
  cursor: pointer;
  padding: 0;
  
  li {
    margin: 0 0 0.125em;
    padding: 0;
    list-style: none;
    opacity: 0.7;

    &.isActive,
    &:hover {
      opacity: 1;
    }

    &.isHidden {
      display: none;
    }
  }
}

.filter-name {
  display: block;
  padding: 20px;
  cursor: pointer;
  opacity: 0.5;
  line-height: 1;
}

.cross-container {
  position: relative;
  line-height: 1;

  :global(span) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    position: relative;
    pointer-events: all;
  }

  &::after {
    @mixin button;
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    margin-left: 0.5em;
  }
}

.hasActiveOption .filter-name {
  opacity: 1;
}

.hasActiveOption .cross-container {
  :global(span) {
    display: inline;
  }

  &:after {
    content: '×';
  }
}

input[type="checkbox"]:checked {
& + .options {
    overflow: auto;
    max-height: 80vh;
  }
}

</style>