---
import { ClientRouter } from "astro:transitions";
import { getDatabase } from "../api/api"
import FocusedPlayer from "./FocusedPlayer/FocusedPlayer.astro";

const entries = await getDatabase();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Goodison Memorial</title>
    <ClientRouter />
	</head>
	<body data-entries={JSON.stringify(entries)}>
    <slot />
    <FocusedPlayer />
	</body>
</html>
<script>
  import { $isFiltering, setEntries } from "../store/data";
  const entries = document.body.getAttribute("data-entries");
  if (!entries) {
    throw new Error("No entries found");
  }
  setEntries(entries);
</script>
<style is:global>
  @import '../styles/variables.pcss';
  @import '../styles/typography.pcss';

  * {
    box-sizing: border-box;
  }
  body {
    @mixin body;
    margin: 0;
    width: 100dvw;
    height: 100dvh;
    color: white;
    background-color: var(--navy);
    overflow: hidden;
    perspective: 100px;
  }
</style>