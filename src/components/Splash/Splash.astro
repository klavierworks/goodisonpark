---
import SimpleStadium from "../SimpleStadium/SimpleStadium";
import Stage1 from "./Stage1/Stage1.astro";
import Stage2 from "./Stage2/Stage2.astro";
---
<div class="stages isActive isLoading showing-stage1" transition:persist transition:persist-props>
  <div class="box">
    <div class="stage stage1 isActive">
      <Stage1 />
    </div>
    <div class="stage stage2">
      <Stage2 />
    </div>
  </div>
</div>
<script>
const stages = document.querySelector('.stages')!;
document.addEventListener('stage2', () => {
  stages.classList.remove('showing-stage1');
  stages.classList.add('showing-stage2');
}, {
  once: true
});
document.addEventListener('splashcomplete', () => {
  stages.classList.remove('isActive');
  stages.querySelector('.stadium')?.remove()
});
const url = new URL(window.location.href);
if (url.searchParams.get('bypassSplash') === 'true') {
  document.dispatchEvent(new CustomEvent('splashcomplete', { bubbles: true }));
}
//document.dispatchEvent(new CustomEvent('splashcomplete', { bubbles: true }));
</script>

<style is:global>
.stages {
  --duration: 3s;
  --delay: 0.5s;
  place-content: center;
  place-items: center;
  width: 100%;
  height: 100%;
  opacity: 1;
  position: fixed;
  inset: 0;
  z-index: 1000;
  background-color: var(--navy);
  display: none;
  cursor: pointer;
  pointer-events: none;

  &.showing-stage1 {
    background: #050717;
  }

  &.showing-stage2 {
    background: #0000004D;
    backdrop-filter: blur(10px);
  }
  
  &.isActive {
    display: flex;
    pointer-events: all;
  }

  &.isLoading {
    cursor: wait;
  }

  &.isComplete {
    opacity: 0;
    transition: opacity 1s ease-out;
  }

  .stage1, .stage2 {
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
    pointer-events: none;
  }
  &.showing-stage1 .stage1, &.showing-stage2 .stage2 {
    pointer-events: auto;
    display: grid;
    opacity: 1;
  }
}

.stadium {
  position: absolute !important;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  opacity: 1;
  pointer-events: none;
  z-index: -1;
  transition: opacity 0.5s ease-in-out;

  @media (orientation: portrait) {
    height: auto !important;
    top: 50%;
    translate: 0 -50%;
    aspect-ratio: 5 / 6
  }

  .isLoading & {
    opacity: 0;
  }
}
.box {
  transition: opacity 0.25s ease-in-out;
  position: relative;
  width: 65%;
  height: 70%;
  user-select: none;

  .showing-stage1 & {
    &::before,
    &::after {
      content: '';
      width: 100%;
      position: absolute;
      top: 0;
      left: 0;
      transform-origin: center center;
      height: 1px;
      background-color: white;
      scale: 0 1;
      animation: border var(--duration) var(--delay) linear forwards;
    }

    &::after {
      top: auto;
      bottom: 0;
    }
  }
}
.stage {
  display: none;
  grid-template-rows: 10% 2em 1fr max-content 1fr 2em 10%;
  grid-template-columns: 1fr;
  place-items: center;
  place-content: center;
  height: 100%;
  width: 100%;
}
</style>
<style is:global>

.isLoading {
  .loading {
    display: block;
  }
  .loaded {
    display: none;
  }
}
</style>