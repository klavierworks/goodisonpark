---
import VideoPlayer from '../../../VideoPlayer/VideoPlayer.astro';

const { filename, name } = Astro.props;
type Props = {
  filename: string;
  name: string;
}

---
<div class="tile">
  {filename && <VideoPlayer filename={filename} name={name} />}
</div>
<script>
import type { VideoPlayerElement } from "../../../VideoPlayer/VideoPlayer.astro.0.mts";

document.querySelectorAll('.tile').forEach(tile => {
  const videoElement = tile.querySelector('video-player-element') as VideoPlayerElement | null;
  if (!videoElement) {
    console.error('VideoTileElement: video-player-element not found');
    return;
  }
  let timer: NodeJS.Timeout | null = null;
  tile.addEventListener('mouseover', () => {
    if (timer) {
      return;
    }
    timer = setTimeout(() => {
      if (videoElement) {
        videoElement.playVideo();
      }
    }, 500);
  });
  tile.addEventListener('mouseleave', () => {
    if (timer) {
      clearTimeout(timer);
      timer = null;
    }
    videoElement.pauseVideo();
  });
});
</script>

<style is:global>
.tile {
  position: relative;
  overflow: hidden;
  cursor: pointer;
  width: 100%;
  border: 1px solid transparent;

  &:hover {
    border-color: white;
  }
}
</style>