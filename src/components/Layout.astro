---
import { ClientRouter, fade } from "astro:transitions";
import { getDatabase } from "../api/api"
import FocusedPlayer from "./FocusedPlayer/FocusedPlayer.astro";
import Splash from "./Splash/Splash.astro";

const entries = await getDatabase();
---

<html lang="en" class="noJs">
	<head>
    <script>
      document.documentElement.classList.remove('noJs');
      const timeViewedSplash = window.localStorage.getItem('timeViewedSplash');
      //const hasViewedSplash = timeViewedSplash && Date.now() - parseInt(timeViewedSplash) < 1000 * 60; // 1 minute
      const hasViewedSplash = true;
      if (hasViewedSplash) {
        document.documentElement.classList.add('hasViewedSplash');
      } else if (timeViewedSplash) {
        window.localStorage.removeItem('timeViewedSplash');
      }
    </script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Goodison Memorial</title>
    <ClientRouter />
	</head>
	<body data-entries={JSON.stringify(entries)}>
    <slot />
    <FocusedPlayer />
    <Splash />
	</body>
</html>
<script>
  import { setEntries } from "../store/data";
  const entries = document.body.getAttribute("data-entries");
  if (!entries) {
    throw new Error("No entries found");
  }
  setEntries(entries);
</script>
<style is:global>
  @import '../styles/variables.pcss';
  @import '../styles/typography.pcss';

  * {
    box-sizing: border-box;
  }
  body {
    @mixin body;
    margin: 0;
    width: 100dvw;
    height: 100dvh;
    color: white;
    background-color: var(--navy);
    overflow: hidden;
  }
</style>