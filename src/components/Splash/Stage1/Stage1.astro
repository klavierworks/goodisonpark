---
---
<video src="/splash/16-9.mp4" autoplay muted loop playsinline class="splash-video"></video>
<div class="credit"></div>
<button class="stage1-nav isLoading" disabled>
  []
</button>
<script>
import { $loadProgress } from "../../../store/ui";

window.addEventListener('load', () => {
  if (window.innerWidth > window.innerHeight) {
    (document.querySelector('.splash-video') as HTMLVideoElement).src = '/splash/16-9.mp4';
  } else {
    (document.querySelector('.splash-video') as HTMLVideoElement).src = '/splash/9-16.mp4';
  }
});
const stage1Nav = document.querySelector('.stage1-nav') as HTMLButtonElement;
$loadProgress.subscribe((progress) => {
  if (stage1Nav) {
    stage1Nav.innerText = `[${progress}%]`;
  }

  if (progress >= 100) {
    stage1Nav.innerText = '[Enter]';
    const stages = document.querySelector('.stages')!;
    stages.classList.remove('isLoading');
  }
});

  const stages = document.querySelector('.stages')!;

  const stagesClick = (e: Event) => {
    e.stopPropagation();
    e.preventDefault();
    e.stopImmediatePropagation();
    if ($loadProgress.get() >= 100) {
      stages.removeEventListener('click', stagesClick);
      document.dispatchEvent(new CustomEvent('stage2', { bubbles: true }));
    }
    return false;
  }
  stages?.addEventListener('click', stagesClick);


let interval: NodeJS.Timeout | null = null;
const intervalFunction = () => {
  if ($loadProgress.get() < 100) {
    $loadProgress.set($loadProgress.get() + 1);
  } else {
    clearInterval(interval!);
  }
};
interval = setInterval(intervalFunction, 20);
</script>
<style>
  .splash-video {
    position: fixed;
    inset: 0;
    object-fit: cover;
    height: 100%;
    width: 100%;
    z-index: -1;
  }

.line {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: center;
}

.lines {
  grid-row: 4 / 5;
}
.credit {
  @mixin button;
  grid-row: 2 / 3;
  opacity: 0;
  text-align: center;
  animation: initialStage var(--delay) linear forwards;
}
.stage1-nav {
  @mixin button;
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  appearance: none;
  background-color: transparent;
  border: none;
  color: white;
  cursor: pointer;
  pointer-events: none;
  text-transform: uppercase;
}

</style>