---
---

<div class="location-nav">
  <div class="locator stand">
    <div class="title">Stand</div>
    <div class="detail"></div>
  </div>
  <div class="locator block">
    <div class="title">Block</div>
    <div class="detail"></div>
  </div>
</div>

<script>
import { $block, $currentView, $stand } from "../../store/ui";
$currentView.subscribe((view) => {
  const locatorElement = document.querySelector('.location-nav');
  if (!locatorElement) {
    return;
  }
  if (view === 'space') {
    locatorElement.classList.add('isSpaceView');
    locatorElement.classList.remove('isGridView');
  } else {
    locatorElement.classList.add('isGridView');
    locatorElement.classList.remove('isSpaceView');
  }
});
$block.subscribe(block => {
  const blockElement = document.querySelector('.locator.block .detail');
  if (blockElement) {
    blockElement.textContent = block;
  }
});

$stand.subscribe(stand => {
  const standElement = document.querySelector('.locator.stand .detail');
  if (standElement) {
    standElement.textContent = stand;
  }
});
</script>
<style>
.location-nav {
  display: none;

  &.isSpaceView {
    display: block;
  }
}
.locator {
  @mixin body;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  place-content: center;
  padding: 20px;

  .title {
    opacity: 0.7;
  }
}

.stand {
  left: 0;
  right: initial;
}

.block {
  left: initial;
  place-items: end;
  right: 0;
}
</style>