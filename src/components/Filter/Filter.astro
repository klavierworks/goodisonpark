---
import { getOptionsByFilter } from "../../store/data";
import { getFilterLabel } from "../../api/utils";

type Props = {
  class: string;
  filter: Filter;
}

const { class: className, filter, ...rest } = Astro.props as Props;

const options = getOptionsByFilter(filter)
---
<filter-element data-filter={filter} class={`${className} ${filter}`} {...rest}>
  <ul class="options">
    {options.map((option) => (
      <li data-option={option}>{option}</li>
    ))}
  </ul>
  <div class="filter-name" data-name="name-click-target">
    <span class="name-span">{getFilterLabel(filter)}</span>
    <button class="cross">×</button>
  </div>
</filter-element>
<script>
import { getFilterLabel } from "../../api/utils";
import { $activeFilters } from "../../store/data";
import { $hasOpenFilters, $hoveredEntry } from "../../store/ui";

class FilterElement extends HTMLElement {
  cleanups: (() => void)[] = [];
  isOpen = false;
  filter: Filter = this.getAttribute('data-filter')?.trim() as Filter;

  connectedCallback() {
    this.addEventListener('click', this.handleClick);
    window.addEventListener('click', this.handleClickOutside)

    const activeFiltersCleanup = $activeFilters.subscribe(() => {
      this.writeName();

      if ($activeFilters.get()[this.filter]) {
        this.classList.add('hasActiveOption');
      } else {
        this.classList.remove('hasActiveOption');
      }
    });

    const hoveredEntryCleanup = $hoveredEntry.subscribe(() => {
      this.writeName();
      if ($hoveredEntry.get()?.[this.filter]) {
        this.classList.add('hasActiveHoverOption');
      } else {
        this.classList.remove('hasActiveHoverOption');
      }
    });

    this.cleanups.push(activeFiltersCleanup, hoveredEntryCleanup);
  }

  disconnectedCallback() {
    this.cleanups.forEach(cleanup => cleanup());
    window.removeEventListener('click', this.handleClickOutside);
  }

  writeName() {
    const nameElement = this.querySelector('.name-span');
    if (!nameElement) {
      console.warn('No name element found in filter', this.filter);
      return;
    }

    const activeFilter = $activeFilters.get()[this.filter];
    const hoveredEntry = $hoveredEntry.get();
    if (activeFilter) {
      nameElement.textContent = `[${activeFilter}]`;
      return;
    }

    if (hoveredEntry && hoveredEntry[this.filter]) {
      nameElement.textContent = hoveredEntry[this.filter];
      return;
    }

    nameElement.textContent = getFilterLabel(this.filter);
  }

  handleClick(event: MouseEvent) {
    const target = event.target as HTMLElement;

    if (target.dataset.name === 'name-click-target') {
      this.handleClickName();
      return;
    }

    if (target.tagName === 'LI') {
      this.handleClickOption(event);
      return;
    }

    if (target.classList.contains('backdrop')) {
      this.handleClose();
      return;
    }
  }

  handleClickName() {
    if ($activeFilters.get()[this.filter]) {
      this.clearFilter();
      return;
    }

    if (this.isOpen) {
      this.handleClose();
      return;
    }
    
    if (!this.isOpen) {
      this.handleOpen();
      return;
    }
  }

  handleOpen() {
    this.isOpen = true;
    this.classList.add('isOpen')
    $hasOpenFilters.set(true);
  }

  handleClose() {
    this.isOpen = false;
    this.classList.remove('isOpen');
    $hasOpenFilters.set(false);
  }

  handleClickOutside = (event: MouseEvent) => {
    if (!this.isOpen) {
      return;
    }
    const target = event.target as HTMLElement;
    const isClickInside = this.contains(target);
    if (!isClickInside) {
      this.handleClose();
    }
  }

  clearFilter() {
    const newFilters = { ...$activeFilters.get() };
    delete newFilters[this.filter];

    $activeFilters.set(newFilters);
  }

  handleClickOption(event: MouseEvent) {
    this.handleClose();
    const target = event.target as HTMLLIElement;
    const option = target.getAttribute('data-option');
    const isFilterBeingDeactivated = $activeFilters.get()[this.filter] === option;

    if (isFilterBeingDeactivated) {
      this.clearFilter();
      return;
    }

    const newFilters = {
      ...$activeFilters.get(),
      [this.filter]: option,
    };

    $activeFilters.set(newFilters);

    event.preventDefault();
    event.stopPropagation();
  }
}

if (!customElements.get('filter-element')) {
  customElements.define('filter-element', FilterElement);
}
</script>
<style>
filter-element {
  @mixin ui-button;
  @mixin body;
  position: relative;
  overflow: hidden;
  text-align: center;
  pointer-events: auto;
  max-height: 24px;
  
  &.isOpen {
    max-height: 75vh;
  }

  &:not(.memory) {
    @media (max-width: 600px) {
      display: none;
    }
  }
}

.options {
  @mixin body;
  display: flex;
  flex-direction: column;
  max-height: 75vh;
  width: 100%;
  overflow-y: auto;
  text-align: left;
  justify-content: flex-start;
  align-content: flex-start;
  opacity: 0;
  pointer-events: none;
  padding: 3px;
  margin: 0;

  &::-webkit-scrollbar {
    width: 4px;
    background: rgb(150 150 150)
  }

  &::-webkit-scrollbar-thumb {
    background: white;
    border-radius: 8px;
  }

  .isOpen & {
    opacity: 1;
    pointer-events: auto;
  }

  li {
    cursor: pointer;
    width: 100%;
    list-style: none;
    margin: 2px 0;
    text-transform: capitalize;
  }
}

.filter-name {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 3px;
  height: 24px;
  display: flex;
  width: 100%;
  flex-direction: row;
  align-items: flex-start;
  align-items: center;
  cursor: pointer;

  .isOpen & {
    display: none;
  }


  .name-span {
    @mixin body;
    line-height: 1.2;
    pointer-events: none;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }
  .cross {
    appearance: none;
    border: none;
    background: transparent;
    color: white;
    display: none;
    pointer-events: none;
    
    .hasActiveOption & {
      display: block;
    }
  }
}
</style>