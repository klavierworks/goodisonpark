---
const WORDS = [
  'Nothing',
  'but',
  'the',
  'best'
];

---
<div class="credit">A project<br /> by Global Fandom</div>
<div class="lines">
  <div class="line">
    {WORDS.slice(0,2).map((word, index) => (
      <div class={`word word${index + 1}`}>
      {word}
    </div>
  ))}
  </div>
  <div class="line">
    {WORDS.slice(-2).map((word, index) => (
      <div class={`word word${index + 3}`}>
        {word}
      </div>
    ))}
  </div>
</div>
<div class="loading">
  Loading
</div>
<div class="loaded">
  Click to<br />
  Enter
</div>
<script>
import { $loadProgress } from "../../../store/ui";

$loadProgress.subscribe((progress) => {
  const progressElement = document.querySelector('.progress');
  if (progressElement) {
    progressElement.textContent = `${progress}%`;
  }
  console.log(`Load progress: ${progress}%`);
  if (progress >= 100) {
    document.querySelector('.isLoading')?.classList.remove('isLoading');
  }

  document.querySelector('.stages')?.addEventListener('click', (e) => {
    if ($loadProgress.get() >= 100) {
      if (window.sessionStorage.getItem('hasViewedSplash') === 'true') {
        document.dispatchEvent(new CustomEvent('splashcomplete', { bubbles: true }));
      }
      document.dispatchEvent(new CustomEvent('stage2', { bubbles: true }));
    }
    e.stopPropagation();
    e.preventDefault();
  });
});


window.setTimeout(() => {
  $loadProgress.set(100);
}, 2000); // Simulate loading completion after 3 seconds
</script>
<style>

.line {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: center;
}

.lines {
  grid-row: 4 / 5;
}
.credit {
  @mixin button;
  grid-row: 2 / 3;
  opacity: 0;
  text-align: center;
  animation: initialStage var(--delay) linear forwards;
}
.loaded,
.loading {
  @mixin button;
  text-align: center;
  grid-row: 6 / 7;
  opacity: 0;
  display: none;
  animation: initialStage var(--delay) linear forwards;
}
.loaded {
  display: block;
  cursor: pointer;
}
.word {
  @mixin title;
  font-size: 7vw;
  text-align: center;
  padding: 0 0.25em;
  opacity: 0;

  &.word1 {
    animation: word1 var(--duration) var(--delay) linear forwards;
  }
  &.word2 {
    animation: word2 var(--duration) var(--delay) linear forwards;
  }
  &.word3 {
    animation: word3 var(--duration) var(--delay) linear forwards;
  }
  &.word4 {
    animation: word4 var(--duration) var(--delay) linear forwards;
  }
}

@keyframes initialStage {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}
@keyframes border {
  0% {
    scale: 0 1;
  }
  100% {
    scale: 1 1;
  }
}

@keyframes word1 {
  0% {
    opacity: 0;
  }
  15% {
    opacity: 0;
  }
  45% {
    opacity: 1;
  }
  100% {
    opacity: 1;
  }
}

@keyframes word2 {
  0% {
    opacity: 0;
  }
  30% {
    opacity: 0;
  }
  65% {
    opacity: 1;
  }
  100% {
    opacity: 1;
  }
}

@keyframes word3 {
  0% {
    opacity: 0;
  }
  45% {
    opacity: 0;
  }
  75% {
    opacity: 1;
  }
  100% {
    opacity: 1;
  }
}
@keyframes word4 {
  0% {
    opacity: 0;
  }
  60% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}
@keyframes stadium {
  0% {
    opacity: 0;
  }
  50% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

</style>