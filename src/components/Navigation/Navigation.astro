---
import { getFilters } from "../../api/utils";
import Filter from "../../components/Filter/Filter.astro";
import SimpleStadium from "../SimpleStadium/SimpleStadium.tsx";

const filters = getFilters();
---
<div class="filters isGridView" transition:name="filters" transition:persist>
  {filters.map(filter => <Filter class="filter" filter={filter} />)}
  <div class="view-toggle">
    <div class="map">
      <SimpleStadium client:only />
    </div>
    <button class="view grid" data-view="grid">Grid</button>
    <button class="view space" data-view="space">Space</button>
  </div>
</div>
<script>
import { $activeFilters } from "../../store/data";
import { $currentView } from "../../store/ui";

const mapElement = document.querySelector('.map');
$activeFilters.subscribe((filters) => {
  if (!mapElement) {
    return;
  }
  const currentFilterCount = Object.values(filters).length;
   if (currentFilterCount > 0) {
    mapElement.classList.add('hasActiveFilters');
  } else {
    mapElement.classList.remove('hasActiveFilters');
  }
});

const filtersElement = document.querySelector('.filters');
$currentView.subscribe((view) => {
  if (!filtersElement) {
    return;
  }
  if (view === 'space') {
    filtersElement.classList.add('isSpaceView');
    filtersElement.classList.remove('isGridView');
  } else {
    filtersElement.classList.add('isGridView');
    filtersElement.classList.remove('isSpaceView');
  }
});

document.querySelectorAll('.view').forEach(button => {
  button.addEventListener('click', (e) => {
    e.preventDefault();
    const view = (e.target! as HTMLButtonElement).dataset.view as View;
    $currentView.set(view);
    const searchParams = new URLSearchParams(window.location.search);
    searchParams.set('view', view);
    window.history.replaceState({}, '', `${window.location.pathname}?${searchParams.toString()}`);
  });
});

</script>
<style>
.filters {
  @mixin grid;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  pointer-events: none;

  @media (max-width: 600px) {
    display: flex;
    flex-direction: row-reverse;
    justify-content: start;
  }
}

.filter {
  grid-column: span 1;
  grid-row: 2 / 3;

  &:nth-child(1),
  &:nth-child(2) {
    order: 1;
  }

  &:nth-child(4),
  &:nth-child(5) {
    order: 3;
  }
}

.view-toggle {
  display: grid;
  grid-template-columns: repeat(2, 48px);
  grid-template-rows: max-content max-content;
  order: 2;
  place-self: center;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  grid-row: 1 / 3;
  margin: 0 0 1.5em;
  
  @media (max-width: 600px) {
    grid-column: 1 / 2;
  }

  .view {
    @mixin button;
    grid-row: 2 / 3;
    display: flex;
    place-content: center;
    place-items: center;
    border: 1px solid white;
    padding: 5px 6px;
    text-decoration: none;
    pointer-events: auto;
    color: white;
    background-color: var(--navy);

    &:nth-child(3) {
      grid-column: 2 / 3 ;
    }
    
    &:nth-child(4){
      grid-column: 3 / 4;
    }
  }
}

.isGridView .grid,
.isSpaceView .space {
    color: var(--navy);
    background-color: white;
  }

.map {
  position: relative;
  grid-row: 1 / 2;
  grid-column: 1 / 3;
  aspect-ratio: 1 / 1;
  border: 1px solid white;
  background-color: var(--navy);
  z-index: -1;
  translate: 0 100%;
  transition: translate 0.3s ease-in-out;

  @media (max-width: 600px) {
    display: none;
  }
  
  a {
    pointer-events: all;
    cursor: pointer;
  }

  .isGridView & {
    @media (max-width: 600px) {
      display: none;
    }
  }

  .isSpaceView & {
    pointer-events: none !important;

    :global(div) {
      pointer-events: none !important;
    }
  }

  &.hasActiveFilters {
    translate: 0 0 !important;
  }
}
</style>

<style is:global>
  .map div {
    touch-action: none;
  }
  .isCanvasView canvas {
    pointer-events: none;
  }
</style>