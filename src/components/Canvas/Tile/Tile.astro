---
import type { ImageMetadata } from 'astro';
import { Image as AstroImage } from 'astro:assets';

const { class: className, entry, ...rest } = Astro.props;
type Props = {
  entry: Entry & {
    count: number;
  };
}

const fileNameWithoutExtension = entry.filename.split('.').slice(0, -1).join('.');

const images = Object.entries(import.meta.glob('../../../../public/videos/**/*.jpg', { eager: true }) as Record<string, { default: string }>);

const image = images.find(([key]) => key.includes(fileNameWithoutExtension))![1].default;

const imageMetadata = image as unknown as ImageMetadata;
const width = imageMetadata.width ?? 0;
const height = imageMetadata.height ?? 0;

const aspectRatio = width / height;
const isLandscape = aspectRatio > 1;
---
<tile-element data-id={entry.id} class={`isVisible ${className}`} {...rest}>
  <AstroImage src={image} alt={entry.name} inferSize style={`--aspect-ratio: ${aspectRatio}`} class={isLandscape ? 'isLandscape' : 'isPortrait'} />
  <h2>
    <span class="memory">{entry.memory}</span>
    <span class="year">{entry.year}</span>
    <span class="count">+{entry.count}</span>
</tile-element>
<script>
import { $entries } from "../../../store/data";

  export class TileElement extends HTMLElement {
    connectedCallback() {
      const id = this.getAttribute('data-id') as string;
      $entries.subscribe(entries => {
        const isVisible = !!entries.find(entry => entry.id === id);
        if (isVisible) {
          this.classList.add('isVisible');
        } else {
          this.classList.remove('isVisible');
        }
      });
    }
  }

  if (!customElements.get('tile-element')) {
    customElements.define('tile-element', TileElement);
  }
</script>

<style is:global>
tile-element {
  display: flex;
  flex-direction: column;
  align-items: start;
  justify-content: center;
  opacity: 0;
  transition: all 0.25s ease-in-out;
  overflow: hidden;
  height: 100%;
  width: 100%;
  
  &.isVisible {
    opacity: 0.6;
  }
  &:hover {
    opacity: 1;
  }

  img {
    grid-row: 1 / 2;
    object-fit: contain;
    object-position: left top;
    cursor: pointer;
  }

  .isLandscape {
    width: 100%;
    height: auto;
  }

  .isPortrait {
    width: auto;
    height: 100%;
  }

  h2 {
    @mixin caption;
    grid-row: 2 / 3;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1em;
    margin: 0;
    white-space: nowrap;
  }

  .count {
    display: block;
    background-color: rgba(255 255 255 / 0.05);
    padding: 0.25em;
    line-height: 1;
  }
}
</style>