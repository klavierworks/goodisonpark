---
import Masonry from './Masonry/Masonry.astro';

type Props = {
  isRear?: boolean;
}

const { isRear = false } = Astro.props

---
<canvas-element isRear={isRear}>
  <Masonry />
</canvas-element>
<script>
import { $canvasOffset } from "../../store/data";

class CanvasElement extends HTMLElement {
  isMouseOver = false;
  isRear = false;
  masonryElement = null as unknown as HTMLDivElement;
  mouseX = 0;
  mouseY = 0;

  offsetX = 0;
  offsetY = 0;

  connectedCallback() {
    this.isRear = this.hasAttribute('isRear') && this.getAttribute('isRear') === 'true';

    this.classList.remove('noJs');

    if (this.isRear) {
      this.classList.add('isRear')
      return;
    }

    this.masonryElement = this.querySelector('masonry-element') as HTMLDivElement;

    this.addEventListener('mousemove', this.handleMouseMove);
    this.addEventListener('mouseenter', () => {
      this.isMouseOver = true;
    });
    this.addEventListener('mouseleave', () => {
      this.isMouseOver = false;
    });

    requestAnimationFrame(this.handleFrame.bind(this));
  }

  handleMouseMove(event: MouseEvent) {
    this.isMouseOver = true;
    this.mouseX = event.screenX - (window.innerWidth / 2);
    this.mouseY = event.screenY - (window.innerHeight / 2);
  }
  handleFrame() {
    if (!this.isMouseOver) {
      requestAnimationFrame(this.handleFrame.bind(this));
      return;
    }
    
    if (Math.abs(this.mouseX) > window.innerWidth / 8) {
      this.offsetX -= (this.mouseX / (window.innerWidth / 2)) * 10;
    }
    
    if (Math.abs(this.mouseY) > window.innerHeight / 8) {
      this.offsetY -= (this.mouseY / (window.innerHeight / 2)) *  10;
    }

    const halfWidth = (this.masonryElement.clientWidth / 2) - (window.innerWidth / 2);
    const halfHeight = (this.masonryElement.clientHeight / 2) - (window.innerHeight / 2);

    this.offsetX = Math.max(Math.min(halfWidth, this.offsetX), -halfWidth);
    this.offsetY = Math.max(Math.min(halfHeight, this.offsetY), -halfHeight);

    this.style.setProperty('--offset-x', `${Number(this.offsetX).toFixed(1)}px`);
    this.style.setProperty('--offset-y', `${Number(this.offsetY).toFixed(1)}px`);

    $canvasOffset.set({
      x: this.offsetX,
      y: this.offsetY,
    });

    requestAnimationFrame(this.handleFrame.bind(this));
  }
}
if (!customElements.get('canvas-element')) {
  customElements.define('canvas-element', CanvasElement);
}
</script>

<style is:global>
canvas-element {
  --offset-x: 0px;
  --offset-y: 0px;
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;

  masonry-element {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(calc(-50% + var(--offset-x)), calc(-50% + var(--offset-y)));
  }

  &.isRear {
    position: absolute;
    top: 0%;
    left: 0%;
    z-index: -1;
    pointer-events: none;
    opacity: 0.1;
    transform: translateZ(-50px);
  }
}
</style>