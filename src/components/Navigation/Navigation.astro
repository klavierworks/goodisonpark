---
import { Image } from "astro:assets";
import { getFilters } from "../../api/utils";
import Filter from "../../components/Filter/Filter.astro";
import Location from "../Location/Location.astro";
import SimpleStadium from "../SimpleStadium/SimpleStadium.tsx";

import Grid from "./grid.svg";
import Left from "./left.svg";
import Right from "./right.svg";

const filters = getFilters();
---
<Location />
{filters.map(filter => <Filter class="filter" filter={filter} />)}
<div class="map">
  <SimpleStadium client:only />
</div>
<button class="left"><Left /></button>
<button class="grid-button"><Grid /></button>
<button class="right"><Right /></button>
<script>
import { $activeFilters , $focusedEntry, getEntryIndexById } from "../../store/data";
import { $currentView, $selectedEntry } from "../../store/ui";
import { $entries } from "../../store/data";

const mapElement = document.querySelector('.map');
$activeFilters.subscribe((filters) => {
  if (!mapElement) {
    return;
  }
  const currentFilterCount = Object.values(filters).length;
   if (currentFilterCount > 0) {
    mapElement.classList.add('hasActiveFilters');
  } else {
    mapElement.classList.remove('hasActiveFilters');
  }
});

const gridButton = document.querySelector('.grid-button')!;
gridButton.addEventListener('click', (e) => {
  e.preventDefault();
  $currentView.set('grid');
  window.history.replaceState({}, '', `${window.location.pathname}?view=grid`);
});

const handleNavigate = (e: Event, direction: 'left' | 'right') => {
  e.preventDefault();

  const isFocused = $focusedEntry.get() !== null;
  const currentSelectedEntryId = isFocused ? $focusedEntry.get() : $selectedEntry.get();
  if (!currentSelectedEntryId) {
    return;
  }

  const currentIndex = getEntryIndexById(currentSelectedEntryId);
  let nextIndex = direction === 'left' ? currentIndex - 1 : currentIndex + 1;
  if (nextIndex < 0) {
    nextIndex = $entries.get().length - 1;
  } else if (nextIndex >= $entries.get().length) {
    nextIndex = 0;
  }
  
  const nextEntry = $entries.get()[nextIndex];
  if (!nextEntry) {
    return;
  }

  if (isFocused) {
    $focusedEntry.set(nextEntry.id);
  }
  
  $selectedEntry.set(nextEntry.id);
}

const leftButton = document.querySelector('.left')!;
leftButton.addEventListener('click', e => handleNavigate(e, 'left'));
const rightButton = document.querySelector('.right')!;
rightButton.addEventListener('click', e => handleNavigate(e, 'right'));;
</script>
<style>
  :root {
    @media (min-width: 600px) {
      --filter-width: ((100% - (6 * 20px)) / 5);
    }
  }

.filter {
  position: fixed;
  left: 20px;
  bottom: 20px;
  right: 120px;
  
  @media (min-width: 600px) {
    width: calc(var(--filter-width));
    right: initial;

    &.year {
      left: calc(40px + var(--filter-width));
    }

    &.name {
      left: calc(60px + (var(--filter-width) * 2));
    }

    &.category {
      left: calc(80px + (var(--filter-width) * 3));
    }

    :global(.isGridView) & {
      --filter-width: ((100% - (5 * 20px)) / 4);
    }
  }

  :global(.isFocused) & {
    display: none;
  }
}

.view-toggle {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: max-content max-content;
  gap: 5px;
  position: relative;
  overflow: hidden;
  position: fixed;
  right: 20px;
  bottom: 20px;
  width: 80px;

  @media (min-width: 600px) {
    width: calc(var(--filter-width));
  }

  :global(.isGridView) & {
    display: none;
  }
  
}


.map {
  @mixin ui-button;
  position: fixed;
  right: 20px;
  bottom: 50px;
  width: 80px;
  aspect-ratio: 1 / 1;

  pointer-events: none !important;

  @media (min-width: 600px) {
    width: calc(var(--filter-width));
  }

  :global(.isGridView) & {
    display: none;
  }

  :global(div) {
    pointer-events: none !important;
  }
}

button {
  @mixin ui-button;
  @mixin button;
  position: absolute;
  bottom: 20px;
  width: calc(var(--width) - 4px);

  display: flex;
  place-content: center;
  place-items: center;
  border: none;
  height: 24px;
  padding: 3px;
  text-decoration: none;
  pointer-events: auto;
  cursor: pointer;
  color: white;

  --width: 42px;

  :global(.isGridView) & {
    display: none;
  }

  @media (min-width: 600px) {
    --width: (var(--filter-width) / 3);
  }
}

.left {
  right: 62px;
  @media (min-width: 600px) {
    left: calc(100px + (var(--filter-width) * 4));
  }
}

.grid-button {
  display: none;

  @media (min-width: 600px) {
    display: flex;
    left: calc(102px + (var(--filter-width) * 4) + var(--width));
  }
}

.right {
  right: 20px;

  @media (min-width: 600px) {
    left: calc(104px + (var(--filter-width) * 4) + (var(--width) * 2));
  }
}
</style>

<style is:global>
  .map div {
    touch-action: none;
  }
  .isCanvasView canvas {
    pointer-events: none;
  }
</style>