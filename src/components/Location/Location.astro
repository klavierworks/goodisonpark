---
---

<div class="location-nav">
  <div class="locator stand">
    <div class="detail"></div>
  </div>
  <div class="locator block">
    <div class="detail"></div>
  </div>
</div>

<script>
import { $block, $currentView } from "../../store/ui";
import {STAND_MAPPING} from './STAND_MAPPING';

$currentView.subscribe((view) => {
  const locatorElement = document.querySelector('.location-nav');
  if (!locatorElement) {
    return;
  }
  if (view === 'space') {
    locatorElement.classList.add('isSpaceView');
    locatorElement.classList.remove('isGridView');
  } else {
    locatorElement.classList.add('isGridView');
    locatorElement.classList.remove('isSpaceView');
  }
});

const getStand = (block: string): string => {
  const map = Object.entries(STAND_MAPPING).find(([_, blocks]) => blocks.includes(block));
  return map ? map[0] : '';
}
const blockElement = document.querySelector('.locator.block .detail');
const standElement = document.querySelector('.locator.stand .detail');
$block.subscribe(block => {
  if (blockElement) {
    blockElement.textContent = block;
  }
  if (standElement) {
    standElement.textContent = getStand(block);
  }
});

</script>
<style>
.location-nav {
  display: none;

  &.isSpaceView {
    display: block;
  }
}
.locator {
  @mixin button;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  place-content: center;
  padding: 20px;

  .title {
    opacity: 0.7;
  }
}

.stand {
  left: 0;
  right: initial;
}

.block {
  left: initial;
  place-items: end;
  right: 0;
}
</style>