---
import { getOptionsByFilter } from "../../api/api";

type Props = {
  class: string;
  filter: Filter;
}

const { class: className, filter, ...rest } = Astro.props as Props;

const unsortedOptions = await getOptionsByFilter(filter)
const options = unsortedOptions.sort((a, b) => {
  const aName = a.toLowerCase();
  const bName = b.toLowerCase();
  if (aName < bName) {
    return -1;
  }
  if (aName > bName) {
    return 1;
  }
  return 0;
});
---
<filter-element data-filter={filter} class={className} {...rest}>
  <input type="checkbox" id={`filter-${filter}`} />
  <ul class="options">
    {options.map((option) => (
      <li data-option={option}>{option}</li>
    ))}
  </ul>
  <label for={`filter-${filter}`} class="filter-name">
    <span>{filter}</span>
    <span class="arrow"></span>
  </label>
</filter-element>
<script>
import { $activeFilters, $entries } from "../../store/data";

class FilterElement extends HTMLElement {
  isOpen = false;
  filter: Filter = this.getAttribute('data-filter')?.trim() as Filter;
  checkboxElement: HTMLInputElement = this.querySelector('input[type="checkbox"]')!

  connectedCallback() {
    this.querySelectorAll('li').forEach((option) => {
      option.addEventListener('click', this.handleClickOption.bind(this));
    });

    $entries.subscribe((entries) => {
      const options = entries.map((entry) => entry[this.filter]).filter(Boolean);
      const uniqueOptions = Array.from(new Set(options));
      this.querySelectorAll('li').forEach((option) => {
        const optionElement = option as HTMLLIElement;
        const optionName = optionElement.getAttribute('data-option');
        if (uniqueOptions.includes(optionName!)) {
          optionElement.classList.remove('isHidden');
        } else {
          optionElement.classList.add('isHidden');
        }
      });
    });

    $activeFilters.subscribe((activeFilters) => {
      const filterNameElement = this.querySelector('.filter-name') as HTMLSpanElement;
      const currentFilter = activeFilters[this.filter];
      this.querySelectorAll('li').forEach((option) => {
        const optionElement = option as HTMLLIElement;
        const isActive = currentFilter === optionElement.innerText;
        optionElement.classList.toggle('isActive', isActive);
      });
      if (currentFilter) {
        filterNameElement.innerText = currentFilter;
        this.classList.add('hasActiveOption');
      } else {
        filterNameElement.innerText = this.filter;
        this.classList.remove('hasActiveOption');
      }
    });

    this.checkboxElement.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      const isOpen = !!target.checked;
      
      if (isOpen) {
        this.handleOpen();
      } else {
        this.handleClose();
      }
    });
  }

  handleOpen() {
    this.isOpen = true;
    this.checkboxElement.checked = true;

    window.addEventListener('click', this.handleClickOutside)
  }
  handleClose() {
    this.isOpen = false;
    this.checkboxElement.checked = false;

    window.removeEventListener('click', this.handleClickOutside)
  }

  handleClickOutside = (event: MouseEvent) => {
    const target = event.target as HTMLElement;
    const isClickInside = this.contains(target);
    if (!isClickInside) {
      this.handleClose();
    }
  }

  handleClickOption(event: MouseEvent) {
    this.handleClose();
    const target = event.target as HTMLLIElement;
    const isFilterBeingDeactivated = $activeFilters.get()[this.filter] === target.innerText;

    const newFilters = {
      ...$activeFilters.get(),
      [this.filter]: target.innerText,
    };

    if (isFilterBeingDeactivated) {
      delete newFilters[this.filter];
    }

    $activeFilters.set(newFilters);
  }
}

if (!customElements.get('filter-element')) {
  customElements.define('filter-element', FilterElement);
}
</script>
<style>
input[type="checkbox"] {
  display: none;
}
filter-element {
  @mixin body;
  width: 100%;
  text-align: center;
  position: relative;
}

.options {
  position: absolute;
  bottom: 100%;
  left: 0;
  right: 0;
  max-height: 0;
  transition: max-height 0.5s ease-in-out;
  overflow: hidden;
  scrollbar-width: none;
  margin: 0;
  cursor: pointer;
  padding: 0;
  
  li {
    margin: 0 0 0.125em;
    padding: 0;
    list-style: none;
    opacity: 0.5;

    &.isActive,
    &:hover {
      opacity: 1;
    }

    &.isHidden {
      display: none;
    }
  }
}

.filter-name {
  display: block;
  padding: 20px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  cursor: pointer;
  opacity: 0.5;

  .hasActiveOption & {
    opacity: 1;
  }
}
input[type="checkbox"]:checked {
  & + .options {
    overflow: auto;
    max-height: 80vh;
  }
}

</style>