---
import { ClientRouter, fade } from "astro:transitions";
import { getDatabase } from "../api/api"
import FocusedPlayer from "./FocusedPlayer/FocusedPlayer.astro";
import Splash from "./Splash/Splash.astro";
import { setEntries } from "../store/data";
import Navigation from "./Navigation/Navigation.astro";

const entries = await getDatabase();
setEntries(entries);
---

<html lang="en" class="noJs">
	<head>
    <script define:vars={{entries}}>
      window.entries = entries;
    </script>
    <script>
      document.documentElement.classList.remove('noJs');
    </script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Goodison" />
    <link rel="manifest" href="/site.webmanifest" />
		<title>Goodison Memorial</title>
    <meta name="description" content="Goodison Park is the first purpose built football stadium in the world. Now, it has become the first ever digital stadium archive." />
    <meta property="og:title" content="Goodison Memorial" />
    <meta property="og:image" content="/ogmeta.png" />
    <ClientRouter />
	</head>
	<body>
    <slot />
    <FocusedPlayer />
    <Navigation />
    <Splash />
	</body>
</html>
<script>
  import { $focusedEntry, setEntries } from "../store/data";
import { $currentView } from "../store/ui";
  const entries = window.entries
  if (!entries) {
    throw new Error("No entries found");
  }
  setEntries(entries);

  $currentView.subscribe((view) => {
    document.body.classList.toggle('isGridView', view === 'grid');
    document.body.classList.toggle('isSpaceView', view === 'space');
  });
  $focusedEntry.subscribe((focusedEntry) => {
    const isFocused = focusedEntry !== null;
    document.body.classList.toggle('isFocused', isFocused);
  });

</script>
<style is:global>
  @import '../styles/variables.pcss';
  @import '../styles/typography.pcss';

  * {
    box-sizing: border-box;
  }
  body {
    @mixin body;
    margin: 0;
    width: 100dvw;
    height: 100dvh;
    color: white;
    background-color: var(--navy);
    overflow: hidden;
  }

  canvas {
    user-select: none;
  }

  @keyframes zoomOut {
    0% {
      opacity: 0;
      transform: scale(0.75);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }



  @media (pointer: coarse) and (max-width: 600px) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }

    [data-astro-transition-scope] {
      animation: none !important;
    }
  }
</style>