---
import Masonry from './Masonry/Masonry.astro';

type Props = {
  isRear?: boolean;
}

const { isRear = false, ...rest } = Astro.props

const anim = {
  old: {
    name: "zoomOut",
    duration: "0.25s",
    easing: "ease-in",
    direction: "reverse",
  },
  new: {
    name: "zoomOut",
    duration: "0.25s",
    easing: "ease-in-out",
  },
};

const customTransition = {
  forwards: anim,
  backwards: anim,
};

---
<canvas-element isRear={isRear} transition:animate={customTransition} transition:name="main" {...rest}>
  <Masonry isRear={isRear} />
</canvas-element>
<script>
import { DragGesture } from '@use-gesture/vanilla';
import { $activeFilters, $canvasOffset, $entries } from "../../store/data";
import { $hasOpenFilters } from "../../store/ui";
import { TechnicolorShader } from 'three/examples/jsm/Addons.js';

class CanvasElement extends HTMLElement {
  isMouseOver = false;
  isRear = false;
  masonryElement = null as unknown as HTMLDivElement;
  mouseX = 0;
  mouseY = 0;

  offsetX = 0;
  offsetY = 0;

  cleanups: (() => void)[] = [];
  gesture: DragGesture | null = null;

  connectedCallback() {
    this.isRear = this.hasAttribute('isRear') && this.getAttribute('isRear') === 'true';

    this.classList.remove('noJs');

    if (this.isRear) {
      this.classList.add('isRear')
      return;
    }
    document.documentElement.style = `--offset-x: 0px; --offset-y: 0px;`;

    this.masonryElement = this.querySelector('masonry-element') as HTMLDivElement;

    this.addEventListener('mousemove', this.handleMouseMove);
    this.addEventListener('mouseenter', () => {
      this.isMouseOver = true;
    });
    this.addEventListener('mouseleave', () => {
      this.isMouseOver = false;
    });
    
    document.addEventListener('filtering', (event) => {
      this.handleFiltering(event as CustomEvent);
    })

    const hasOpenFiltersListener = $hasOpenFilters.subscribe((hasOpenFilters) => {
      if (hasOpenFilters) {
        this.classList.add('hasOpenFilters');
      } else {
        this.classList.remove('hasOpenFilters');
      }
    });

    this.cleanups.push(hasOpenFiltersListener);

    this.gesture = new DragGesture(this.masonryElement, ({ active, movement: [mx, my] }) => {
      this.isMouseOver = active;
      if (!active) {
        return;
      }

      this.mouseX = -mx * 1.5;
      this.mouseY = -my * 1.5;
    });

    requestAnimationFrame(this.handleFrame.bind(this));
  }

  disconnectedCallback() {
    this.cleanups.forEach(cleanup => cleanup());
    this.gesture?.destroy()
  }

  pause(ms: number) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  async handleFiltering(event: CustomEvent) {
    this.classList.add('isFiltering');
    await this.pause(500);
    this.mouseX = 0;
    this.mouseY = 0;
    this.offsetX = 0;
    this.offsetY = 0;
    $activeFilters.set(event.detail.filters);
    
    const unsubscribe = $entries.subscribe(() => {
      this.pause(500).then(() => {
        this.classList.remove('isFiltering');
        unsubscribe();
      });
    });
  }

  handleMouseMove(event: MouseEvent) {
    this.isMouseOver = true;
    this.mouseX = event.screenX - (window.innerWidth / 2);
    this.mouseY = event.screenY - (window.innerHeight / 2);
  }

  calculateOffset(x: number, y: number) {
    if (Math.abs(x) > window.innerWidth / 8) {
      this.offsetX -= (x / (window.innerWidth / 2)) * 10;
    }
    
    if (Math.abs(y) > window.innerHeight / 8) {
      this.offsetY -= (y / (window.innerHeight / 2)) *  10;
    }

    const halfWidth = (this.masonryElement.clientWidth / 2) - (window.innerWidth / 2);
    const halfHeight = (this.masonryElement.clientHeight / 2) - (window.innerHeight / 2);

    this.offsetX = Math.max(Math.min(halfWidth, this.offsetX), -halfWidth);
    this.offsetY = Math.max(Math.min(halfHeight, this.offsetY), -halfHeight);

    if (this.masonryElement.clientWidth < window.innerWidth) {
      this.offsetX = 0;
    }
    if (this.masonryElement.clientHeight < window.innerHeight) {
      this.offsetY = 0;
    }

    document.documentElement.style = `--offset-x: ${Number(this.offsetX).toFixed(1)}px; --offset-y: ${Number(this.offsetY).toFixed(1)}px;`;

    $canvasOffset.set({
      x: this.offsetX,
      y: this.offsetY,
    });
  }
  handleFrame() {
    if (!this.isMouseOver) {
      requestAnimationFrame(this.handleFrame.bind(this));
      return;
    }

    this.calculateOffset(this.mouseX, this.mouseY);

    requestAnimationFrame(this.handleFrame.bind(this));
  }
}
if (!customElements.get('canvas-element')) {
  customElements.define('canvas-element', CanvasElement);
}
</script>

<style is:global>
canvas-element {
  perspective: 20px;
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
  opacity: 1;
  user-select: none;
  transition: opacity 0.5s ease-in-out;

  &::after {
    position: fixed;
    inset: 0;
    background-color: var(--navy);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease-in-out;
    content: ';';
  }
  
  &.hasOpenFilters::after {
    opacity: 0.8;
  }

  &.isFiltering {
    opacity: 0 !important;
  }

  masonry-element {
    touch-action: none;
    transform-style: preserve-3d;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(calc(-50% + var(--offset-x)), calc(-50% + var(--offset-y)));
  }

  &.isRear {
    position: absolute;
    top: -50vh;
    left: -50vw;
    min-width: 200vw;
    min-height: 200vh;
    z-index: -1;
    pointer-events: none;
    opacity: 0.1;
    transform: scale(0.7) translateX(-5%);

    .column {
      --column-modifier: 4 !important;

      &:nth(odd) {
        --row-modifier: -4 !important;
      }
    }
  }
}
</style>