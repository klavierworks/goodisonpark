---
import VideoPlayer from '../VideoPlayer/VideoPlayer.astro';

---
<focused-player-element>
  <VideoPlayer filename="" name="" />
  <div class="details"></div>
</focused-player-element>

<script>
import { $allEntries, $focusedEntry } from "../../store/data";
import type { VideoPlayerElement } from "../VideoPlayer/VideoPlayer.astro.0.mts";

export class FocusedPlayerElement extends HTMLElement {
  cleanups: (() => void)[] = [];
  entry: Entry | null = null;
  isActive = false

  connectedCallback() {
    window.addEventListener('click', this.handleClick.bind(this));
    window.addEventListener('mousemove', this.handleMouseMove.bind(this));

    const focusedEntryListener =  $focusedEntry.subscribe(entry => {
      this.setActiveFocusedEntry();
    });

    const allEntriesListener = $allEntries.subscribe(entries => {
      this.setActiveFocusedEntry();
    });

    this.cleanups.push(focusedEntryListener, allEntriesListener);
  }

  disconnectedCallback() {
    this.cleanups.forEach(cleanup => cleanup());
    window.removeEventListener('click', this.handleClick.bind(this));
    window.removeEventListener('mousemove', this.handleMouseMove.bind(this));
  }

  setActiveFocusedEntry() {
    this.entry = $allEntries.get().find(e => e.id === $focusedEntry.get()) || null;

    if (this.entry) {
      this.handleActive();
    } else {
      this.handleClose();
    }
  }

  handleMouseMove(event: MouseEvent) {
    if (!this.isActive) {
      return;
    }
    this.style.setProperty('--mouse-x', `${event.clientX}px`);
    this.style.setProperty('--mouse-y', `${event.clientY}px`);
  }

  handleClick(event: MouseEvent) {
    if (!this.isActive) {
      return;
    }
    event.stopPropagation();
    event.preventDefault();
    const target = event.target as HTMLElement;
    const hasClickedVideoTile = !!target.closest('video');
    const hasClickedRear = !!target.closest('focused-player-element');

    if (hasClickedVideoTile) {
      (this.querySelector('video-player-element') as VideoPlayerElement).toggleVideo();
      return;
    }

    if (hasClickedRear) {
      this.handleClose();
      return;
    }
  }

  handleActive() {
    if (!this.entry) {
      return;
    }

    const videoPlayerElement = this.querySelector('video-player-element') as VideoPlayerElement | null;
    if (!videoPlayerElement) {
      console.error('FocusedPlayerElement: video-player-element not found');
      return;
    }
    videoPlayerElement.setAttribute('filename', this.entry.id);
    videoPlayerElement.setAttribute('name', this.entry.name);
    videoPlayerElement.setAttribute('muted', 'false');
    console.log('setup called for entry:', this.entry);
    videoPlayerElement.setupVideo();
    this.querySelector('.details')!.innerHTML = `
        <div>${this.entry.year}</div>
        <div>${this.entry.memory}</div>
        <div>${this.entry.stand}</div>
        <div>${this.entry.block}</div>
    `;
    
    this.isActive = true;
    this.classList.add('isActive');
  }

  handleClose() {
    this.isActive = false;
    this.classList.remove('isActive');
    const videoPlayerElement = this.querySelector('video-player-element') as VideoPlayerElement;
    if (!videoPlayerElement || !videoPlayerElement.reset) {
      return;
    }
    videoPlayerElement.reset();
    $focusedEntry.set(null);
  }
}

if (!customElements.get('focused-player-element')) {
  customElements.define('focused-player-element', FocusedPlayerElement);
}
</script>

<style is:global>
focused-player-element {
  --mouse-x: 0px;
  --mouse-y: 0px;
  position: fixed;
  inset: 0;
  display: flex;
  place-content: center;
  place-items: center;
  opacity: 0;
  transition: all 0.3s ease-in-out;
  backdrop-filter: blur(0px);
  pointer-events: none;
  
  &.isActive {
    opacity: 1;
    pointer-events: auto;
    backdrop-filter: blur(10px);
  }

  &::after {
    @mixin body;
    position: fixed;
    top: 20px;
    left: 20px;
    transform: translate(var(--mouse-x), var(--mouse-y));
    z-index: 2;
    content: 'Close';
    display: none;
  }


  &:has(video:hover)::after {
    content: 'Play';
  }
  &:has(.isPlaying video:hover)::after {
    content: 'Pause';
  }

  @media (pointer: fine) {  
    &.isActive::after {
      display: block;
    }
  }

  video-player-element {
    z-index: 1;
    width: 80% !important;
    cursor: pointer;
    height: 80% !important;
    display: flex;
    place-content: center;
    place-items: center;

    @media (min-width: 600px) {
      width: calc(80% - (var(--filter-width) * 2)) !important;
    }

    video {
      position: relative !important;
      height: auto !important;
    }


    &.isPortrait video {
      width: auto !important;
      height: 100% !important;
    }
  }

  .details {
    @mixin button;
    z-index: 2;
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    display: grid;
    pointer-events: none;
    grid-template-columns: repeat(4, 1fr);
    text-align: center;
    text-transform: capitalize;

    @media (max-width: 600px) {
      transform: translateY(-50%);
      height: 75%;
      align-items: center;
      grid-template-rows: repeat(4, 1fr);
      grid-template-columns: 1fr;
    }

  }
}
</style>