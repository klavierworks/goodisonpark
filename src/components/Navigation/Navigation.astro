---
import { getFilters } from "../../api/utils";
import Filter from "../../components/Filter/Filter.astro";
import SimpleStadium from "../SimpleStadium/SimpleStadium.tsx";

type Props = {
  section: "grid" | "space";
}

const {section} = Astro.props;

const filters = getFilters();

const url = Astro.url;
const isSpaceView = url.pathname.includes('space');
---
<div class="filters">
  {filters.map(filter => <Filter class="filter" filter={filter} />)}
  <div class="view-toggle">
    <a class={`view ${section == 'grid' ? 'isActive' : ''}`}  href="/">Grid</a>
    <a class={`view ${section == 'space' ? 'isActive' : ''}`} href="/space">Space</a>
  </div>
  <div class={`map ${isSpaceView ? 'isSpaceView' : ''}`}>
    {isSpaceView ? (
      <SimpleStadium isShowingPoints={true} client:only />
    ) : (
      <a href="/space">
        <SimpleStadium client:only />
      </a>
    )}
  </div>
</div>
<script>
  document.querySelectorAll('a.view').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const href = link.getAttribute('href');
      if (!href) {
        return;
      }
      const currentUrl = new URL(window.location.href);
      const newUrl = new URL(href, currentUrl.origin);
      newUrl.search = currentUrl.search;
      window.location.href = newUrl.toString();
    });
  });
</script>
<style>
.filters {
  @mixin grid;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  pointer-events: none;
}

.map {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  width: 12.5vw;
  height: 12.5vw;
  border: 1px solid white;
  background-color: var(--navy);
  
  a {
    pointer-events: all;
    cursor: pointer;
  }

  &.isSpaceView {
    pointer-events: auto;
    cursor: grab;
  }
}
.filter {
  grid-column: span 1;

  &:nth-child(1),
  &:nth-child(2) {
    order: 1;
  }

  &:nth-child(4),
  &:nth-child(5) {
    order: 3;
  }
}

.view-toggle {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  order: 2;
  place-self: center;

  .view {
    @mixin button;
    display: flex;
    place-content: center;
    place-items: center;
    border: 1px solid white;
    padding: 5px 6px;
    text-decoration: none;
    pointer-events: auto;
    color: var(--navy);
    background-color: white;
  }
  
  .isActive {
    color: white;
    background-color: transparent;
  }
}
</style>

<style is:global>
  .map div {
    touch-action: none;
  }
  .map:not(.isSpaceView) canvas {
    pointer-events: none;
  }
</style>