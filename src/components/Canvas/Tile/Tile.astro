---
import VideoTile from './VideoTile/VideoTile.astro';

const { class: className, entry, isRear, ...rest } = Astro.props;
type Props = {
  class?: string;
  entry: Entry & {
    count: number;
  };
  isRear: boolean;
}

---
<tile-element data-id={entry.id} class={`isVisible ${className}`} {...rest}>
  <VideoTile filename={entry.filename} name={entry.name} />
  {!isRear && (
    <h2>
      <span class="memory">{entry.memory}</span>
      <span class="year">{entry.year}</span>
      <span class="count">+{entry.count}</span>
    </h2>
  )}
</tile-element>
<script>
import { $entries } from "../../../store/data";

  export class TileElement extends HTMLElement {
    connectedCallback() {
      const id = this.getAttribute('data-id') as string;
      $entries.subscribe(entries => {
        const isVisible = !!entries.find(entry => entry.id === id);
        if (isVisible) {
          this.classList.add('isVisible');
        } else {
          this.classList.remove('isVisible');
        }
      });
    }
  }

  if (!customElements.get('tile-element')) {
    customElements.define('tile-element', TileElement);
  }
</script>

<style is:global>
tile-element {
  display: inline-flex;
  flex-direction: column;
  align-items: start;
  justify-content: center;
  opacity: 1;
  transition: all 0.25s ease-in-out;
  overflow: hidden;
  height: 100%;

  &.isHidden {
    opacity: 0 !important;
    height: 0px;
    width: 0px;
  }

  h2 {
    @mixin caption;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1em;
    margin: 0;
    white-space: nowrap;
  }

  .count {
    display: block;
    background-color: rgba(255 255 255 / 0.05);
    padding: 0.25em;
    line-height: 1;
  }
}
</style>