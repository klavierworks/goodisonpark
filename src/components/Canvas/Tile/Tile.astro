---
import VideoTile from './VideoTile/VideoTile.astro';

const { class: className, entry, isRear, ...rest } = Astro.props;
type Props = {
  class?: string;
  entry: Entry & {
    count: number;
  };
  isRear: boolean;
}

---
<tile-element data-id={entry.id} class={`${className} ${isRear ? 'isRear' : ''} isVisible`} isRear={isRear} {...rest} data-entry={JSON.stringify(entry)}>
  <a href={`/space?memory=${entry.memory}`} data-astro-prefetch="tap">
    <VideoTile filename={entry.filename} name={entry.name} />
    {!isRear && (
      <h2>
      <span class="memory">{entry.memory}</span>
      <span class="year">{entry.year}</span>
      <span class="count">+{entry.count}</span>
    </h2>
  )}
  </a>
</tile-element>
<script>
import { $entries, $focusedEntry } from "../../../store/data";
import { $hoveredEntry } from "../../../store/ui";

export class TileElement extends HTMLElement {
  entry = null as unknown as Entry & { count: number };
  connectedCallback() {
    const id = this.getAttribute('data-id') as string;
    const isRear = this.hasAttribute('isRear') && this.getAttribute('isRear') === 'true';

    const entryData = this.getAttribute('data-entry');
    if (entryData) {
      try {
        this.entry = JSON.parse(entryData);
      } catch (error) {
        console.error('TileElement: Invalid entry data', error);
      }
    }
    if (isRear) {
      return;
    }
    $entries.subscribe(entries => {
      const isVisible = !!entries.find(entry => entry.id === id);
      if (isVisible) {
        this.classList.add('isVisible');
      } else {
        this.classList.remove('isVisible');
      }
    });

    const hoverTarget = this.querySelector('a') as HTMLAnchorElement;
    if (!hoverTarget) {
      console.error('TileElement: No anchor element found');
      return;
    }
    hoverTarget.addEventListener('mouseover', () => {
      $hoveredEntry.set(this.entry);
    });

    hoverTarget.addEventListener('mouseleave', () => {
      $hoveredEntry.set(null);
    });
  }
}

if (!customElements.get('tile-element')) {
  customElements.define('tile-element', TileElement);
}
</script>

<style is:global>
tile-element {
  height: 0;
  padding: 0;
  display: inline-flex;
  flex-direction: column;
  align-items: start;
  justify-content: center;
  opacity: 1;
  transition: all 0.25s ease-in-out;
  overflow: hidden;
  transform-origin: center center;

  a {
    display: contents;
    color: inherit;
    transform-style: preserve-3d;
    text-decoration: none;
  }

  &.isVisible {
    height: 100%;
    padding: 4vw;
  }

  h2 {
    @mixin button;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1em;
    margin: 0;
    white-space: nowrap;
  }

  .count {
    display: block;
    background-color: rgba(255 255 255 / 0.05);
    padding: 0.25em;
    line-height: 1;
  }

  .memory {
    overflow: hidden;
    text-overflow: ellipsis;
  }
}

.column {
  --column-modifier: 1;
  transform-style: preserve-3d;
  pointer-events: none;
  
  tile-element {
    pointer-events: auto;
      transform: translateZ(calc(var(--column-modifier) * var(--row-modifier) * 1px));

      &:nth-child(odd) {
        --row-modifier: 2;
      }
      &:nth-child(even) {
        --row-modifier: 1;
      }
      &:nth-child(5n) {
        --row-modifier: 3;
      }
      &:nth-child(3n) {
        --row-modifier: -1;
      }
    }

  &:nth-child(odd) {
    --column-modifier: -1;
  }
}
</style>