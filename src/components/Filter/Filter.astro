---
import { getOptionsByFilter } from "../../store/data";
import { getFilterLabel } from "../../api/utils";
import { Image } from "astro:assets";

type Props = {
  class: string;
  filter: Filter;
}

const { class: className, filter, ...rest } = Astro.props as Props;

const options = getOptionsByFilter(filter)
---
<filter-element data-filter={filter} class={`${className} ${filter}`} {...rest}>
  <div class="backdrop"></div>
  <ul class="options">
    <div class="content">
      {options.map((option) => (
        <li data-option={option}>{option}</li>
      ))}
    </div>
  </ul>
  <div class="toggle-box" data-name="name-click-target">
    <div class="cross-container" data-name="name-click-target">
      <span class="name">
        {getFilterLabel(filter)}
      </span>
    </div>
    <Image class="mobile-filter" alt="filter" src={import('./mdi_filter.svg')} />
    <Image class="mobile-filter active" alt="filter" src={import('./mdi_filter-active.svg')} />
  </div>
</filter-element>
<script>
import { getFilterLabel } from "../../api/utils";
import { $activeFilters, getOptionsByFilter, $entries } from "../../store/data";
import { $hasOpenFilters, $hoveredEntry } from "../../store/ui";

class FilterElement extends HTMLElement {
  cleanups: (() => void)[] = [];
  isOpen = false;
  filter: Filter = this.getAttribute('data-filter')?.trim() as Filter;

  connectedCallback() {
    this.addEventListener('click', this.handleClick);
    window.addEventListener('click', this.handleClickOutside)

    const activeFiltersCleanup = $activeFilters.subscribe(() => {
      this.writeName();

      if ($activeFilters.get()[this.filter]) {
        this.classList.add('hasActiveOption');
      } else {
        this.classList.remove('hasActiveOption');
      }
    });

    const hoveredEntryCleanup = $hoveredEntry.subscribe(() => {
      this.writeName();
      if ($hoveredEntry.get()?.[this.filter]) {
        this.classList.add('hasActiveHoverOption');
      } else {
        this.classList.remove('hasActiveHoverOption');
      }
    });

    this.cleanups.push(activeFiltersCleanup, hoveredEntryCleanup);
  }

  disconnectedCallback() {
    this.cleanups.forEach(cleanup => cleanup());
    window.removeEventListener('click', this.handleClickOutside);
  }

  writeName() {
    const nameElement = this.querySelector('.name');
    if (!nameElement) {
      console.warn('No name element found in filter', this.filter);
      return;
    }

    const activeFilter = $activeFilters.get()[this.filter];
    const hoveredEntry = $hoveredEntry.get();
    if (activeFilter) {
      nameElement.textContent = activeFilter;
      return;
    }

    if (hoveredEntry && hoveredEntry[this.filter]) {
      nameElement.textContent = hoveredEntry[this.filter];
      return;
    }

    nameElement.textContent = getFilterLabel(this.filter);
  }

  handleClick(event: MouseEvent) {
    event.stopPropagation();
    const target = event.target as HTMLElement;
    console.log(target)
    if (target.dataset.name === 'name-click-target') {
      this.handleClickName();
      return;
    }

    if (target.tagName === 'LI') {
      this.handleClickOption(event);
      return;
    }
  }

  handleClickName() {
    if ($activeFilters.get()[this.filter]) {
      this.clearFilter();
      return;
    }

    if (this.isOpen) {
      this.handleClose();
      return;
    }
    
    if (!this.isOpen) {
      this.handleOpen();
      return;
    }
  }

  handleOpen() {
    this.isOpen = true;
    this.classList.add('isOpen')
    $hasOpenFilters.set(true);
  }

  handleClose() {
    this.isOpen = false;
    this.classList.remove('isOpen');
    $hasOpenFilters.set(false);
  }

  handleClickOutside = (event: MouseEvent) => {
    if (!this.isOpen) {
      return;
    }
    const target = event.target as HTMLElement;
    const isClickInside = this.contains(target);
    if (!isClickInside) {
      this.handleClose();
    }
  }

  clearFilter() {
    const newFilters = { ...$activeFilters.get() };
    delete newFilters[this.filter];

    document.dispatchEvent(new CustomEvent('filtering', {
      detail: {
        filters: newFilters,
      },
    }));
  }

  handleClickOption(event: MouseEvent) {
    this.handleClose();
    const target = event.target as HTMLLIElement;
    const option = target.getAttribute('data-option');
    const isFilterBeingDeactivated = $activeFilters.get()[this.filter] === option;

    if (isFilterBeingDeactivated) {
      this.clearFilter();
      return;
    }

    const newFilters = {
      ...$activeFilters.get(),
      [this.filter]: option,
    };

    document.dispatchEvent(new CustomEvent('filtering', {
      detail: {
        filters: newFilters,
      },
    }));

    this.classList.add('hasActiveOption');

    event.preventDefault();
    event.stopPropagation();
  }
}

if (!customElements.get('filter-element')) {
  customElements.define('filter-element', FilterElement);
}
</script>
<style>
filter-element {
  @mixin body;
  width: 100%;
  text-align: center;
  position: relative;
  pointer-events: auto;
  
  &:not(.memory) {
    @media (max-width: 600px) {
      display: none;
    }
  }
}

.backdrop {
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-color: lab(var(--navy-tuple) / 0.3);
  opacity: 0;
  transition: opacity 0.5s ease-in-out;
  z-index: -1;

  .isOpen & {
    opacity: 1;
    pointer-events: auto;
  }
}
.options {
  position: absolute;
  bottom: 100%;
  left: 0;
  right: 0;
  height: 100dvh;
  overflow: auto;
  display: flex;
  flex-direction: column;
  margin: 0;
  cursor: pointer;
  padding: 0;
  scrollbar-width: thin;
  --webkit-overflow-scrolling: none;
  scrollbar-color: white transparent;
  translate: 0 calc(100% + 2em);
  margin-bottom: 1em;
  padding-top: 25dvh;
  mask: linear-gradient(to bottom, transparent 0%, transparent 15%, black 25%, black 100%);

  .isOpen & {
    translate: 0 0;
  }

  .content {
    margin-top: auto;
    height: max-content;
    max-height: 80dvh;
  }
  
  li {
    margin: 0 0 0.25em;
    padding: 0;
    list-style: none;
    opacity: 0.7;

    &.isActive,
    &:hover {
      opacity: 1;
    }

    &.isHidden {
      display: none;
    }
  }
}

.toggle-box {
  margin: 0 0 1.5em;
  cursor: pointer;
}

.cross-container {
  position: relative;
  max-width: 100%;
  width: max-content;
  margin: 0 auto;
  pointer-events: none;
  cursor: pointer;

  &::after {
    content: '';
    position: absolute;
    left: calc(100% + 0.5em);
    top: 50%;
    pointer-events: all;
    transform: translateY(calc(-50% - 1px));
    color: white;
  }

  .hasActiveOption & {
    &::after {
      content: '×';
      cursor: pointer;
    }
  }
}

.name {
  position: relative;
  display: inline-block;
  overflow: hidden;
  max-width: 100%;
  text-overflow: ellipsis;
  opacity: 0.5;
  white-space: nowrap;
  pointer-events: none;
  cursor: pointer;

  .hasActiveHoverOption & {
    opacity: 1;
  }

  .hasActiveOption & {
    opacity: 1;
  }
}

.mobile-filter {
  display: none;
}

@media (max-width: 600px) {
  .filters {
    bottom: 24px;
  }
  .toggle-box {
    margin: 0;
    display: flex;
    place-content: center;
    place-items: center;
    width: 100%;
    height: 100%;
  }
  .memory {
    position: relative;
    display: flex;
    place-content: center;
    place-items: center;
    border: 1px solid white;
    width: 24px;
    grid-column: 2 / 3;
    height: 22px;
    margin: 0 0 1.5em;

    .filter-name {
      padding: 0;
      opacity: 1;
    }

    .options {
      position: fixed;
      inset: 0;
      top: 0;
      bottom: 0;
      text-align: left;
      max-height: initial !important;
      overflow: auto;
      padding: 20dvh 20px;
      z-index: -1;
      
      &::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
      }
    }

    .content {
      display: contents;
    }

    .cross-container {
      height: 0px;
      width: 0px;
      overflow: hidden;
      position: absolute;
      left: 0;
      top: 0;
      visibility: hidden;
    }

    .mobile-filter {
      display: flex;
      place-content: center;
      place-items: center;
      height: 1.2em;
      width: 1.2em;
      pointer-events: none;

      &.active {
        display: none;
      }
    }

    &.hasActiveOption {
      background-color: white;
      .mobile-filter {
        display: none;

        &.active {
          display: flex;
        }
      }
    }
 
  }

}
</style>