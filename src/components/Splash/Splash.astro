---
import Stage1 from "./Stage1/Stage1.astro";
import Stage2 from "./Stage2/Stage2.astro";
---
<div class="stages isActive" transition:persist>
  <Stage1 />
  <Stage2 />
</div>
<script>
const stages = document.querySelector('.stages')!;
document.addEventListener('stage2', () => {
  stages.querySelector('.stage1')?.classList.remove('isActive');
  stages.querySelector('.stage2')?.classList.add('isActive');
});
document.addEventListener('stage3', () => {
  stages.querySelector('.stage2')?.classList.remove('isActive');
 // window.sessionStorage.setItem('hasViewedSplash', 'true');
  document.dispatchEvent(new CustomEvent('splashcomplete', { bubbles: true }));
});
document.addEventListener('splashcomplete', () => {
  stages.querySelector('.stage1')?.classList.remove('isActive');
  stages.querySelector('.stage2')?.classList.remove('isActive');
  stages.classList.remove('isActive');
});
</script>

<style is:global>
  .stages {
    position: fixed;
    inset: 0;
    background-color: var(--navy);
    z-index: 1000;
    display: none;

    &.isActive {
      display: block;
    }
    .stage1, .stage2 {
      opacity: 0;
      transition: opacity 0.5s ease-in-out;
      pointer-events: none;
    }
    .stage1.isActive, .stage2.isActive {
      pointer-events: auto;
      opacity: 1;
    }
  }
</style>