---
import { getOptionsByFilter } from "../../store/data";
import { getFilterLabel } from "../../api/utils";
import { Image } from "astro:assets";

type Props = {
  class: string;
  filter: Filter;
}

const { class: className, filter, ...rest } = Astro.props as Props;

const options = getOptionsByFilter(filter)
---
<filter-element data-filter={filter} class={`${className} ${filter}`} {...rest}>
  <input type="checkbox" id={`filter-${filter}`} />
  <ul class="options">
    {options.map((option) => (
      <li data-option={option}>{option}</li>
    ))}
  </ul>
  <label for={`filter-${filter}`} class="filter-name">
    <span class="cross-container">
      <span>{getFilterLabel(filter)}</span>
    </span>
    <Image class="mobile-filter" alt="filter" src={import('./mdi_filter.svg')} />
    <Image class="mobile-filter active" alt="filter" src={import('./mdi_filter-active.svg')} />
  </label>
</filter-element>
<script>
import { getFilterLabel } from "../../api/utils";
import { $activeFilters, getOptionsByFilter, $entries } from "../../store/data";
import { $hasOpenFilters, $hoveredEntry } from "../../store/ui";

class FilterElement extends HTMLElement {
  cleanups: (() => void)[] = [];
  isOpen = false;
  filter: Filter = this.getAttribute('data-filter')?.trim() as Filter;
  checkboxElement: HTMLInputElement = this.querySelector('input[type="checkbox"]')!

  connectedCallback() {
    this.querySelectorAll('li').forEach((option) => {
      option.addEventListener('click', this.handleClickOption.bind(this));
    });

    const entriesListener = $entries.subscribe(() => {
      const uniqueOptions = getOptionsByFilter(this.filter);
      this.querySelectorAll('li').forEach((option) => {
        const optionElement = option as HTMLLIElement;
        const optionName = optionElement.getAttribute('data-option');
        if (uniqueOptions.includes(optionName!)) {
          optionElement.classList.remove('isHidden');
        } else {
          optionElement.classList.add('isHidden');
        }
      });
    });

    this.cleanups.push(entriesListener);

    const filterNameElement = this.querySelector('.cross-container')! as HTMLSpanElement;

    let previousHtml: string | undefined = undefined;
    const activeFilterListener = $activeFilters.subscribe((activeFilters) => {
      const currentFilter = activeFilters[this.filter];
      this.querySelectorAll('li').forEach((option) => {
        const optionElement = option as HTMLLIElement;
        const isActive = currentFilter === optionElement.innerText;
        optionElement.classList.toggle('isActive', isActive);
      });
      if (currentFilter) {
        filterNameElement.innerHTML = `<span>${currentFilter}</span>`;
        previousHtml = filterNameElement.innerHTML;
        this.classList.add('hasActiveOption');
      } else {
        filterNameElement.innerHTML = `<span>${getFilterLabel(this.filter)}</span>`;
        this.classList.remove('hasActiveOption');
      }
    });

    this.cleanups.push(activeFilterListener);

    const hoveredEntryListener = $hoveredEntry.subscribe((hoveredEntry) => {
      if (hoveredEntry && hoveredEntry[this.filter]) {
        previousHtml = filterNameElement.innerHTML;
        this.classList.add('hasActiveHoverOption');
        filterNameElement.innerHTML = `<span>${hoveredEntry[this.filter]}</span>`;
      } else if (previousHtml) {
        this.classList.remove('hasActiveHoverOption');
        filterNameElement.innerHTML = previousHtml;
        previousHtml = undefined
      }
    });

    this.cleanups.push(hoveredEntryListener);

    this.addEventListener('click', (event) => {
      if (!this.classList.contains('hasActiveOption')) {
        return;
      }
      event.stopPropagation();
      event.preventDefault();
      this.clearFilter();
    });

    this.checkboxElement.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      const isOpen = !!target.checked;
      
      if (isOpen) {
        this.handleOpen();
      } else {
        this.handleClose();
      }
    });
  }

  disconnectedCallback() {
    this.cleanups.forEach(cleanup => cleanup());
    window.removeEventListener('click', this.handleClickOutside);
  }

  handleOpen() {
    this.isOpen = true;
    this.checkboxElement.checked = true;
    $hasOpenFilters.set(true);

    window.addEventListener('click', this.handleClickOutside)
  }
  handleClose() {
    this.isOpen = false;
    this.checkboxElement.checked = false;
    $hasOpenFilters.set(false);

    window.removeEventListener('click', this.handleClickOutside)
  }

  handleClickOutside = (event: MouseEvent) => {
    const target = event.target as HTMLElement;
    const isClickInside = this.contains(target);
    if (!isClickInside) {
      this.handleClose();
    }
  }

  clearFilter() {
    const newFilters = { ...$activeFilters.get() };
    delete newFilters[this.filter];

    document.dispatchEvent(new CustomEvent('filtering', {
      detail: {
        filters: newFilters,
      },
    }));
  }

  handleClickOption(event: MouseEvent) {
    this.handleClose();
    const target = event.target as HTMLLIElement;
    const option = target.getAttribute('data-option');
    const isFilterBeingDeactivated = $activeFilters.get()[this.filter] === option;

    if (isFilterBeingDeactivated) {
      this.clearFilter();
      return;
    }

    const newFilters = {
      ...$activeFilters.get(),
      [this.filter]: option,
    };

    document.dispatchEvent(new CustomEvent('filtering', {
      detail: {
        filters: newFilters,
      },
    }));

    event.preventDefault();
    event.stopPropagation();
  }
}

if (!customElements.get('filter-element')) {
  customElements.define('filter-element', FilterElement);
}
</script>
<style>
input[type="checkbox"] {
  display: none;
}
filter-element {
  @mixin body;
  width: 100%;
  text-align: center;
  position: relative;
  pointer-events: auto;
  
  &:not(.memory) {
    @media (max-width: 600px) {
      display: none;
    }
  }
}

.options {
  position: absolute;
  bottom: 100%;
  left: 0;
  right: 0;
  max-height: 0;
  transition: max-height 0.5s ease-in-out;
  overflow: auto;
  margin: 0;
  cursor: pointer;
  padding: 0;
  scrollbar-width: thin;
  --webkit-overflow-scrolling: none;
  scrollbar-color: white transparent;
  
  li {
    margin: 0 0 0.125em;
    padding: 0;
    list-style: none;
    opacity: 0.7;

    &.isActive,
    &:hover {
      opacity: 1;
    }

    &.isHidden {
      display: none;
    }
  }
}

.filter-name {
  display: inline-block;
  padding: 20px;
  cursor: pointer;
  opacity: 0.5;
  line-height: 1;
}

.cross-container {
  position: relative;
  display: inline;
  line-height: 1;
  max-width: 100%;

  :global(span) {
    white-space: nowrap;
    overflow: hidden;
    max-width: 100%;
    text-overflow: ellipsis;
    display: inline;
    position: relative;
    pointer-events: all;
  }

  &::after {
    @mixin button;
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    margin-left: 0.5em;
  }
}

.hasActiveHoverOption .filter-name {
  opacity: 1;
}
.hasActiveOption .filter-name {
  opacity: 1;
}

.hasActiveOption .cross-container {

  &:after {
    content: '×';
  }
}

input[type="checkbox"]:checked {
& + .options {
    overflow: auto;
    max-height: 80vh;
  }
}

.mobile-filter {
  display: none;
}

@media (max-width: 600px) {
  .filters {
    bottom: 24px;
  }
  .memory {
    position: relative;
    display: flex;
    place-content: center;
    place-items: center;
    border: 1px solid white;
    width: 24px;
    grid-column: 2 / 3;
    height: 22px;
    margin: 0 0 1.5em;

    .filter-name {
      padding: 0;
      opacity: 1;
    }

    .options {
      position: fixed;
      inset: 0;
      top: 20dvh;
      bottom: 20dvh;
      text-align: left;
      padding: 0 20px;
      max-height: initial !important;
      overflow: auto;
      visibility: hidden;
      z-index: -1;
      
      &::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
      }
    }

    .cross-container {
      height: 0px;
      width: 0px;
      overflow: hidden;
      position: absolute;
      left: 0;
      top: 0;
      visibility: hidden;
    }

    .mobile-filter {
      display: flex;
      place-content: center;
      place-items: center;
      height: 1.2em;
      width: 1.2em;

      &.active {
        display: none;
      }
    }
 
  }


  input[type="checkbox"]:checked {
    & + .options {
      visibility: visible;
    }
  }


  .memory.hasActiveOption,
  .memory:has(input[type="checkbox"]:checked) {

      background-color: white;

      .mobile-filter {
        display: none;

        &.active {
          display: flex;
        }
    }
  }
}
</style>