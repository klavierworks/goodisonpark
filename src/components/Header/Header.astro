---

<header transition:persist>
  <a href="/" id="home-link">
    <h1>Goodison.Memorial</h1>
  </a>
</header>

<script>
document.getElementById('home-link')?.addEventListener('click', (e) => {
  e.preventDefault();
  window.sessionStorage.removeItem('hasViewedSplash');
  window.location.reload()
});
</script>
<style>
header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px 0;
  z-index: 1000;
  pointer-events: none;
  
  a {
    text-decoration: none;
    color: inherit;
  }
  
  h1 {
    @mixin button;
    text-decoration: none;
    color: white;
    margin: 0;
    pointer-events: auto;
    text-transform: none;
  }
}
</style>