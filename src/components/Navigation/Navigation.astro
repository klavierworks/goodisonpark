---
import { Image } from "astro:assets";
import { getFilters } from "../../api/utils";
import Filter from "../../components/Filter/Filter.astro";
import Location from "../Location/Location.astro";
import SimpleStadium from "../SimpleStadium/SimpleStadium.tsx";

import Grid from "./grid.svg";
import Left from "./left.svg";
import Right from "./right.svg";

const filters = getFilters();
---
<Location />
<div class="filters isGridView" transition:name="filters" transition:persist>
  {filters.map(filter => <Filter class="filter" filter={filter} />)}
  <div class="view-toggle">
    <div class="map">
      <SimpleStadium client:only />
    </div>
    <button class="left"><Left /></button>
    <button class="grid-button"><Grid /></button>
    <button class="right"><Right /></button>
  </div>
</div>
<script>
import { $activeFilters } from "../../store/data";
import { $currentView } from "../../store/ui";

const mapElement = document.querySelector('.map');
$activeFilters.subscribe((filters) => {
  if (!mapElement) {
    return;
  }
  const currentFilterCount = Object.values(filters).length;
   if (currentFilterCount > 0) {
    mapElement.classList.add('hasActiveFilters');
  } else {
    mapElement.classList.remove('hasActiveFilters');
  }
});

const filtersElement = document.querySelector('.filters');
$currentView.subscribe((view) => {
  if (!filtersElement) {
    return;
  }
  if (view === 'space') {
    filtersElement.classList.add('isSpaceView');
    filtersElement.classList.remove('isGridView');
  } else {
    filtersElement.classList.add('isGridView');
    filtersElement.classList.remove('isSpaceView');
  }
});

const gridButton = document.querySelector('.grid-button')!;
gridButton.addEventListener('click', (e) => {
  e.preventDefault();
  $currentView.set('grid');
  window.history.replaceState({}, '', `${window.location.pathname}?view=grid`);
});

</script>
<style>
.filters {
  display: grid;
  grid-template-columns: repeat(4, 3fr) 2fr;
  gap: 20px;
  padding: 0 20px;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  pointer-events: none;
  contain: layout;

  @media (max-width: 600px) {
    display: flex;
    flex-direction: row;
    justify-content: start;
    align-items: end;
  }

  &.isGridView {
    grid-template-columns: repeat(4, 3fr) 0px;
  }
}

.filter {
  grid-column: span 1;
  grid-row: 2 / 3;

  &:nth-child(1),
  &:nth-child(2) {
    order: 1;
  }

  &:nth-child(4),
  &:nth-child(5) {
    order: 3;
  }
}

.view-toggle {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5px;
  grid-template-rows: max-content max-content;
  order: 2;
  place-self: center;
  position: relative;
  overflow: hidden;
  grid-row: 1 / 3;
  margin: 0 0 1.5em;
  grid-column: 5 / 6;
  width: 100%;

  @media (max-width: 600px) {
    width: 80px;
    grid-template-columns: repeat(2, 1fr);

    .grid-button {
      display: none;
    }
  }
  
  button {
    @mixin button;
    grid-row: 2 / 3;
    grid-column: span 1;
    display: flex;
    place-content: center;
    place-items: center;
    border: none;
    height: 20px;
    padding: 3px;
    text-decoration: none;
    pointer-events: auto;
    cursor: pointer;
    color: white;
    backdrop-filter: blur(12px);
    background: #FFFFFF0D;
  }
}

.isGridView .grid,
.isSpaceView .space {
    color: var(--navy);
    background-color: white;
  }

.map {
  position: relative;
  grid-row: 1 / 2;
  grid-column: span 3;
  aspect-ratio: 1 / 1;
  background-color: var(--navy);
  z-index: -1;
  backdrop-filter: blur(12px);
  background: #FFFFFF0D;

  @media (max-width: 600px) {
    grid-column: span 2;
  }
  
  a {
    pointer-events: all;
    cursor: pointer;
  }

  .isGridView & {
    @media (max-width: 600px) {
      display: none;
    }
  }

  .isSpaceView & {
    pointer-events: none !important;

    :global(div) {
      pointer-events: none !important;
    }
  }

  &.hasActiveFilters {
    translate: 0 0 !important;
  }
}
</style>

<style is:global>
  .map div {
    touch-action: none;
  }
  .isCanvasView canvas {
    pointer-events: none;
  }
</style>