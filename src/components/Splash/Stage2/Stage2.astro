---
import { Image } from "astro:assets";
const text = [
  'Goodison Park, home of Everton Football Club since 1892, is the first purpose built football stadium in the world.',
  'Paragraph #2',
  'Paragraph #3'
]
---
<div class="stage2 splash">
  <div class="box">
    <Image src={import('../stadium.png')} alt="Stadium" class="image" />
    <div class="title">Goodison Memorial</div>
    <div class="text">
      {text[0]}
    </div>
    <button class="stage2-nav" data-text={JSON.stringify(text)}>
      Click<br />
      <span>1 / 3</span>
    </button>
  </div>
</div>

<script>
let page = 1;
const nav = document.querySelector('.stage2-nav')!
console.log(nav);
const text = JSON.parse(nav.getAttribute('data-text') || '[]');
nav.addEventListener('click', e => console.log(e));
nav.addEventListener('click', () => {
  page++;
  console.log('click')
  if (page > text.length) {
    document.dispatchEvent(new CustomEvent('stage3', { bubbles: true }));
    return;
  }
  document.querySelector('.text')!.textContent = text[page - 1] || '';
  nav.querySelector('span')!.textContent = `${page} / 3`;
});
</script>

<style>
.splash {
  --duration: 3s;
  --delay: 0.5s;
  display: flex;
  place-content: center;
  place-items: center;
  width: 100%;
  height: 100%;
  position: fixed;
  inset: 0;
  z-index: 1000;
  background-color: var(--navy);
}


.box {
  transition: opacity 0.25s ease-in-out;
  position: relative;
  display: grid;
  grid-template-rows: 1fr max-content 1fr max-content 1fr max-content 1fr;
  grid-template-columns: 1fr;
  place-items: center;
  place-content: center;
  width: 65%;
  height: 70%;

  .image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    object-position: center;
  }

  &::before,
  &::after {
    content: '';
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: center center;
    height: 1px;
    background-color: white;
  }

  &::after {
    top: auto;
    bottom: 0;
  }
}

.title {
  grid-row: 2 / 3;
}
.text {
  @mixin title;
  text-transform: none;
  font-size: 3.5vw;
  text-align: center;
  grid-row: 4 / 5;
}
.stage2-nav {
  @mixin button;
  line-height: 1.5;
  appearance: none;
  background-color: transparent;
  border: none;
  color: white;
  cursor: pointer;
  grid-row: 6 / 7;
}
</style>