---
import VideoTile from './VideoTile/VideoTile.astro';

const { class: className, entry, isRear, ...rest } = Astro.props;
type Props = {
  class?: string;
  entry: Entry & {
    count: number;
  };
  isRear: boolean;
}

---
<tile-element data-id={entry.id} class={`${className} ${isRear ? 'isRear' : ''}`} isRear={isRear} {...rest}>
  <a href={`/space?memory=${entry.memory}`}>
    <VideoTile filename={entry.filename} name={entry.name} />
    {!isRear && (
      <h2>
      <span class="memory">{entry.memory}</span>
      <span class="year">{entry.year}</span>
      <span class="count">+{entry.count}</span>
    </h2>
  )}
  </a>
</tile-element>
<script>
import { $entries } from "../../../store/data";

  export class TileElement extends HTMLElement {
    connectedCallback() {
      const id = this.getAttribute('data-id') as string;
      const isRear = this.hasAttribute('isRear') && this.getAttribute('isRear') === 'true';
      if (isRear) {
        return;
      }
      $entries.subscribe(entries => {
        const isVisible = !!entries.find(entry => entry.id === id);
        if (isVisible) {
          this.classList.remove('isHidden');
        } else {
          this.classList.add('isHidden');
        }
      });
    }
  }

  if (!customElements.get('tile-element')) {
    customElements.define('tile-element', TileElement);
  }
</script>

<style is:global>
tile-element {
  width: calc(var(--tile-width));
  height: calc(var(--tile-height));
  padding: 2vh 2vw;

  display: inline-flex;
  flex-direction: column;
  align-items: start;
  justify-content: center;
  opacity: 1;
  transition: all 0.25s ease-in-out;
  overflow: hidden;
  transform-origin: center center;

  a {
    display: contents;
    color: inherit;
    text-decoration: none;
  }

  &.isHidden {
    opacity: 0 !important;
    height: 0px;
    padding: 0px;
    width: 0px;
  }

  h2 {
    @mixin caption;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1em;
    margin: 0;
    white-space: nowrap;
  }

  .count {
    display: block;
    background-color: rgba(255 255 255 / 0.05);
    padding: 0.25em;
    line-height: 1;
  }

  &:nth-child(odd) {
    transform: translateZ(5px);
  }
  &:nth-child(even) {
    transform: translateZ(-5px);
  }

  &.isRear {

    &:nth-child(odd) {
      transform: translateZ(50px);
    }

    &:nth-child(even) {
      transform: translateZ(-50px);
    }
  }
}
</style>