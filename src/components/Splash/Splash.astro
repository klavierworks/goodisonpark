---
const WORDS = [
  'Nothing',
  'but',
  'the',
  'best'
];

const DURATION = 0.75;
const DELAY = 0.5;
---
<div class="splash">
  <div class="text">
    {WORDS.map((word, index) => (
      <div
        class="word"
        style={{
          animationDelay: `${(index + 1) * DELAY}s`,
          animationDuration: `${DURATION}s`,
        }}
      >
        {word}
      </div>
    ))}
  </div>
</div>
<script>
const words = document.querySelectorAll('.word');
const splash = document.querySelector('.splash');
if (!splash) {
  throw new Error('Splash element not found');
}

const lastWord = [...words].at(-1)
if (!lastWord) {
  throw new Error('No last word found');
}
lastWord.addEventListener('animationend', () => {
  splash.classList.add('isComplete');
  window.localStorage.setItem('timeViewedSplash', Date.now().toString());
});
</script>
<style>
  .splash {
    display: flex;
    place-content: center;
    place-items: center;
    width: 100%;
    height: 100%;
    opacity: 1;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background-color: var(--navy);

    &.isComplete {
      opacity: 0;
      transition: opacity 1s ease-out;
      pointer-events: none;
    }
  }
  .text {
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    width: 100%;
    overflow: hidden;
  }
  .word {
    @mixin title;
    text-align: center;
    opacity: 0;
    animation: fadeIn 1s forwards;
    animation-play-state: running;
    animation-timing-function: ease-out;
  }

  @keyframes fadeIn {
    100% {
      opacity: 1;
    }
  }
</style>

<style is:global>
.splash {
  .hasViewedSplash &,
  .noJs & {
    display: none !important;
    pointer-events: none !important;
  }
}
</style>