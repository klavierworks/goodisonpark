---
import Layout from "../components/Layout.astro";
import { getDatabase, getFilters } from "../api/api";
import Canvas from "../components/Canvas/Canvas.astro";
import Filter from "../components/Filter/Filter.astro";

const filters = await getFilters();
---

<Layout>
  <Canvas />
  <div class="filters">
    {filters.map(filter => <Filter filter={filter} />)}
  </div>
</Layout>

<style>
.filters {
  @mixin grid;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
}
</style>