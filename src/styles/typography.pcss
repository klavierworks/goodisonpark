@font-face {
  font-family: Dutch801Roman;
  src: url('/fonts/Dutch 801 Roman BT.woff2') format('woff2'),
       url('/fonts/Dutch 801 Roman BT.woff') format('woff'),
       local('Dutch801Roman');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@define-mixin body-font {
  font-family: Dutch801Roman;
  --webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: geometricPrecision;
}

@define-mixin body-style {
  line-height: 1;
  letter-spacing: -3%;
}

@define-mixin title {
  @mixin body-font;
  @mixin body-style;
  font-size: 124px;
}

@define-mixin heading {
  @mixin body-font;
  @mixin body-style;
  line-height: 1.2;
  font-size: 62px;
}

@define-mixin text {
  @mixin body-font;
  @mixin body-style;

  font-size: 32px;

  @media (max-width: 600px) {
    font-size: 16px;
  }
}

@define-mixin body {
  @mixin body-font;
  @mixin body-style;
  font-size: 12px
}

@define-mixin button {
  @mixin body-font;
  @mixin body-style;
  font-size: 10px;
}
